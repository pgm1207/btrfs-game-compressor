[Unit]
Description=Notify when Steam games on Btrfs are worth re-compressing
Documentation=https://github.com/pablogonz12/btrfs-game-compressor
# The check itself is read-only, but it must not fire while a game is mid-write
# during a Steam update, so it waits for the network to settle first.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --notify only ever reads the library and sends a desktop notification. It
# never compresses a game: acting unattended on the library is out of scope. It
# may also fetch and install a newer release of this tool itself (checksum
# verified), which is what keeps the one-line-installer copy current.
ExecStart=%h/.local/bin/btrfs-game-compressor --notify
# A failed notification (no session bus, headless login) is not a reason to
# mark the whole run as failed and spam the journal.
SuccessExitStatus=0 1
