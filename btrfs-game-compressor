# Throttle stamp for the automatic check: its mtime is the last time the tool
# looked for a newer release.
UPDATE_STAMP="$STATE_DIR/last_update_check"
# Community ratios imported with --import-ratios. Used only as a hint for games
# this machine has never measured; never overrides a real local measurement.
RATIOS_CACHE="$CONFIG_DIR/ratios_hint.json"

# The state file starts with a comment line carrying the format version. It
# exists so a future release can recognise and migrate older records instead of
# silently discarding them, which is what happened when the key changed from the
# game name to the install path: every game looked uncompressed again and the
# whole library had to be re-done. Comments start with '#' and absolute paths
# start with '/', so the two can never be confused.
STATE_HEADER="# btrfs-game-compressor state v2"
STATE_VERSION=2

# Column budgets, in characters, for the name fields of the fixed-width tables.
# LC_ALL=C is forced, so ${#s} counts bytes rather than characters; these are
# therefore upper bounds, and truncate_name backs off to a character boundary.
TUI_NAME_WIDTH=51
STATUS_NAME_WIDTH=40

# --- Colors ---
BOLD="\e[1m"
