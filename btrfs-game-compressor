usage() {
    cat <<EOF
$PROGNAME $VERSION - compress your Steam game library on Btrfs with ZSTD

USAGE
    $PROGNAME [OPTIONS]
    $PROGNAME                      launch the interactive TUI

OPTIONS
    -h, --help            show this help and exit
    -V, --version         print version and exit
    -s, --status          print a non-interactive compression report and exit
    -n, --dry-run         list what would be compressed, change nothing
        --dedupe          manually scan all installed games in each Btrfs library
                          (also marks them COMPACTED after a successful pass)
        --recheck         remeasure installed games and refresh saved statistics
        --assets GAME     preview [BETA] asset optimization for one game
        --apply-assets GAME
                          optimize supported assets and Hades LZ4 packages
                          (Steam: consider Only update when launched)
        --restore-assets GAME
                          restore original assets from the local copy
        --finalize-assets GAME
                           discard restore copy after checking the game works
        --asset-inventory GAME
                            fast format inventory only; does not estimate savings
        --asset-containers GAME
                            list standalone PCK, FMOD and package trial targets
        --audit-game-packs GAME
                            read-only validate every standalone Godot PCK in a game
        --audit-game-fmod GAME
                            read-only validate standalone FMOD banks in a game
        --assets-all
                            fast format inventory for every installed game
        --assets-verify-all
                            read-only Balanced candidate scan for every game
        --compact-all-no-backup
                            checkpointed library pass: supported Balanced assets
                            (irreversible, no restore copy), then Zstd, then
                            dedupe; resumable; writes a stats chart
        --prune-assets GAME
                          remove unused developer debug symbols (*.pdb/*.ilk),
                          retaining a restorable copy
        --prune-fallbacks GAME
                          additionally remove unused 720p/BC3 texture and video
                          fallback suites (only safe if this machine uses the
                          full-resolution assets); restorable
        --variants GAME   read-only report of redundant asset variants (architecture,
                          renderer, resolution or language suites) that share a
                          file-name layout; nothing is changed
        --opportunities   scan every installed game for possible duplicate
                          resolution/platform/language suites; read-only estimate
        --slim GAME       one-shot: remove unused resolution fallbacks, non-host
                          platform folders, debug symbols and (with keep_languages
                          set) other language packs; keeps the highest tier and
                          the host build; restorable
        --keep-languages LIST
                          set the languages --slim will keep, e.g. "en,de" or
                          "English,German"; clears the list when empty
        --engines GAME    read-only report of the game engine (Unity, Unreal,
                          Godot, ...) and where its bytes live; nothing changed
        --audit-container FILE
                           read-only UnityFS/SerializedFile, Godot resource inventory,
                           or Unreal Pak footer/primary-index audit (content-detected)
        --export-unityfs FILE OUTPUT
                          experimental lossless LZ4 bundle recompression; new file
                          only, gated by savings/output-write percentage
        --export-godot FILE OUTPUT
                          experimental lossless PCK resource deduplication; new
                          file only, same percentage gate; preserves resource bytes
        --audit-godot3-audio PROFILE FILE
                          read-only estimate of Godot 3 (.mp3str -> Ogg Vorbis)
                          packed-audio rewriting for a quality profile; no writes
        --export-godot3-audio PROFILE FILE OUTPUT
                          experimental, lossy Godot 3 PCK audio rewrite: decodes
                          AudioStreamMP3 and re-encodes it as Ogg Vorbis under the
                          same entry name, retyping the matching .import stub;
                          new file only, same percentage gate
        --audit-godot-textures PROFILE FILE
                          read-only estimate of PCK texture downscaling for a
                          quality profile; changes nothing
        --export-godot-textures PROFILE FILE OUTPUT
                          experimental PCK texture rewrite: downscales supported
                           Godot 3 .stex / Godot 4 .ctex textures to the profile's longest
                          edge; new file only, same percentage gate. Lossy,
                          export-only; unsupported textures are copied unchanged
        --export-fmod QUALITY FILE OUTPUT
                          experimental FMOD export (conservative, balanced, 0.0-0.4)
                          writes a new file only; never replaces game assets
        --texture-compress MAX_DIM FILE OUTPUT
                          experimental DDS downscale export (2D BC1/2/3/4/5/7 and
                          BGRA/RGBA); preserves the codec and rebuilds mips;
                          writes a new file only; never replaces game assets
        --texture-compress-tree MAX_DIM DIR OUTPUT_DIR
                          experimental export-only pass: mirror every DDS under
                          DIR into OUTPUT_DIR, writing only files that shrink;
                          DIR is never modified
    -l, --library DIR     add DIR as a game library, then exit
                           (accepts the library root or its steamapps/common)
        --pending         with --status/--dry-run, only show pending games
        --history         print separate compression and deduplication history
        --stats           print savings by category (bytes and percent), sorted by percent
        --benchmark       measure real savings per game from recorded data
                          (add --json for machine-readable output)
        --ratios [GAME]   look up expected savings in the community table
                          (add --json for machine-readable output)
        --export-ratios   emit your measured ratios as JSON, ready to
                          contribute to ratios/games.json in the repo
        --import-ratios FILE
                          read a ratios JSON file and use it as a fallback
                          hint for games you have not measured yourself
        --render-ratios   render the community table as Markdown and exit
                          (maintainer command behind 'make ratios-doc')
        --balance         offer native metadata balance on each
                          library's mount point; needs a terminal
        --check-update    report whether a newer release exists, change nothing
        --self-update     download and install the latest release, verifying
                          its SHA256SUMS; refuses when a package manager owns
                          this copy (use pacman/brew/nix instead)
        --uninstall       remove the tool, its manpage and its systemd units;
                          asks first, and never touches your history
        --submit-ratios   offer your measured savings back to the project by
                          opening a GitHub issue with them (needs 'gh', asks
                          first, and never sends anything on its own)
        --yes             with --uninstall or --submit-ratios, do not ask
        --json            with --status/--benchmark/--ratios, emit JSON
        --notify          send a desktop notice for actionable pending games
        --verbose         show each file during compression/deduplication
        --no-color        disable ANSI colors (also honours \$NO_COLOR)

EXAMPLES
    $PROGNAME                        interactive mode
    $PROGNAME --status               one-shot report (safe for scripts/CI)
    $PROGNAME --dry-run --pending    what is still waiting to be compressed
    $PROGNAME --dedupe               full-library maintenance scan (manual)
    $PROGNAME --recheck              refresh measurements without recompressing
    $PROGNAME --library /mnt/games   register a library outside Steam's VDF
    $PROGNAME --balance              finish the job with a filesystem balance
    $PROGNAME --stats                savings by category, sorted by percentage
    $PROGNAME --history              every recorded compression, newest first
    $PROGNAME --benchmark            measured savings per game, sorted
    $PROGNAME --ratios               the whole community table
    $PROGNAME --ratios "Factorio"    what the table expects for one game
    $PROGNAME --status --json        machine-readable report
    $PROGNAME --notify               read-only desktop update notice
    $PROGNAME --check-update         is a newer release available?
    $PROGNAME --self-update          update this copy in place
    $PROGNAME --status | column -t   pipe the report somewhere

FILES
    $CONFIG_DIR
        custom_libraries.txt   extra library roots, one per line
        throttle.conf          0 = full speed, 1 = nice/ionice eco mode
        auto_update            1 = check for a newer release once a day (default)
        keep_languages         languages --slim keeps (codes or names, comma separated)
        min_prune_mib          MiB a delete-only prune must free to be worth doing (default 1)
    $STATE_DIR
        compressed_games.db    compression measurements and timestamps
        dedupe_completed.db   successful dedupe passes used for COMPACTED status
        dedupe_physical_history.db      measured dedupe results, separate from ZSTD

REQUIREMENTS
    Btrfs on Linux 6.15+ is required for explicit ZSTD compression levels.
    The bundled bgc-native executable handles compression, measurement and
    deduplication directly through Linux kernel interfaces. No btrfs-progs,
    compsize or duperemove packages are required. Each game is deduped after its
    compression using a temporary, bounded native index.
EOF
}

version() {
    printf '%s %s\n' "$PROGNAME" "$VERSION"
}

disable_colors() {
    BOLD="" DIM="" CYAN="" GREEN="" YELLOW="" MAGENTA="" RED="" RESET=""
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)     usage; exit 0 ;;
            -V|--version)  version; exit 0 ;;
            -s|--status)   OPT_STATUS=1 ;;
            -n|--dry-run)  OPT_DRY_RUN=1 ;;
            --dedupe)      OPT_DEDUPE=1 ;;
            --recheck)     OPT_RECHECK=1 ;;
            --export-fmod)
                [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                    echo "$PROGNAME: --export-fmod requires QUALITY FILE OUTPUT" >&2; exit 2;
                }
                OPT_FMOD_EXPORT=1; FMOD_QUALITY="$2"; FMOD_SOURCE="$3"; FMOD_OUTPUT="$4"
                shift 3 ;;
            --texture-compress)
                [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                    echo "$PROGNAME: --texture-compress requires MAX_DIM FILE OUTPUT" >&2; exit 2;
                }
                OPT_TEXTURE_COMPRESS=1; TEXTURE_MAX_DIM="$2"; TEXTURE_SOURCE="$3"; TEXTURE_OUTPUT="$4"
                shift 3 ;;
            --texture-compress-tree)
                [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                    echo "$PROGNAME: --texture-compress-tree requires MAX_DIM DIR OUTPUT_DIR" >&2; exit 2;
                }
                OPT_TEXTURE_COMPRESS_TREE=1; TEXTURE_TREE_DIM="$2"; TEXTURE_TREE_INPUT="$3"; TEXTURE_TREE_OUTPUT="$4"
                shift 3 ;;
            --audit-container)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] || { echo "$PROGNAME: --audit-container requires FILE" >&2; exit 2; }
                OPT_CONTAINER=1; CONTAINER_ACTION=audit; CONTAINER_SOURCE="$2"
                shift ;;
            --audit-godot-textures)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] && [ -n "${3:-}" ] || {
                    echo "$PROGNAME: --audit-godot-textures requires PROFILE FILE" >&2; exit 2;
                }
                OPT_CONTAINER=1; CONTAINER_ACTION="$1"; CONTAINER_PROFILE="$2"; CONTAINER_SOURCE="$3"
                shift 2 ;;
            --audit-godot3-audio)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] && [ -n "${3:-}" ] || {
                    echo "$PROGNAME: --audit-godot3-audio requires PROFILE FILE" >&2; exit 2;
                }
                OPT_CONTAINER=1; CONTAINER_ACTION="$1"; CONTAINER_PROFILE="$2"; CONTAINER_SOURCE="$3"
                shift 2 ;;
            --export-godot3-audio)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                    echo "$PROGNAME: --export-godot3-audio requires PROFILE FILE OUTPUT" >&2; exit 2;
                }
                OPT_CONTAINER=1; CONTAINER_ACTION="$1"; CONTAINER_PROFILE="$2"; CONTAINER_SOURCE="$3"; CONTAINER_OUTPUT="$4"
                shift 3 ;;
            --export-godot-textures)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] && [ -n "${3:-}" ] && [ -n "${4:-}" ] || {
                    echo "$PROGNAME: --export-godot-textures requires PROFILE FILE OUTPUT" >&2; exit 2;
                }
                OPT_CONTAINER=1; CONTAINER_ACTION="$1"; CONTAINER_PROFILE="$2"; CONTAINER_SOURCE="$3"; CONTAINER_OUTPUT="$4"
                shift 3 ;;
            --export-unityfs|--export-godot)
                [ "$OPT_CONTAINER" -eq 0 ] || { echo "$PROGNAME: container modes cannot be combined" >&2; exit 2; }
                [ -n "${2:-}" ] && [ -n "${3:-}" ] || {
                    echo "$PROGNAME: $1 requires FILE OUTPUT" >&2; exit 2;
                }
                OPT_CONTAINER=1; CONTAINER_ACTION="$1"; CONTAINER_SOURCE="$2"; CONTAINER_OUTPUT="$3"
                shift 2 ;;
            --assets|--apply-assets|--restore-assets|--finalize-assets)
                [ -n "${2:-}" ] || { echo "$PROGNAME: $1 requires a game name or path" >&2; exit 2; }
                OPT_ASSETS=1
                ASSET_ACTION="$1"
                ASSET_QUERY="$2"
                shift ;;
            --asset-inventory)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --asset-inventory requires a game name or path" >&2; exit 2; }
                OPT_ASSET_INVENTORY=1
                ASSET_QUERY="$2"
                shift ;;
            --asset-containers)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --asset-containers requires a game name or path" >&2; exit 2; }
                OPT_ASSET_CONTAINERS=1
                ASSET_QUERY="$2"
                shift ;;
            --audit-game-packs)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --audit-game-packs requires a game name or path" >&2; exit 2; }
                OPT_AUDIT_GAME_PACKS=1
                ASSET_QUERY="$2"
                shift ;;
            --audit-game-fmod)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --audit-game-fmod requires a game name or path" >&2; exit 2; }
                OPT_AUDIT_GAME_FMOD=1
                ASSET_QUERY="$2"
                shift ;;
            --assets-all) OPT_ASSETS_ALL=1 ;;
            --assets-verify-all) OPT_ASSETS_VERIFY_ALL=1 ;;
            --compact-all-no-backup) OPT_COMPACT_ALL=1 ;;
            --variants)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --variants requires a game name or path" >&2; exit 2; }
                OPT_VARIANTS=1
                VARIANT_QUERY="$2"
                shift ;;
            --opportunities) OPT_OPPORTUNITIES=1 ;;
            --slim)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --slim requires a game name or path" >&2; exit 2; }
                OPT_SLIM=1
                SLIM_QUERY="$2"
                shift ;;
            --engines)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --engines requires a game name or path" >&2; exit 2; }
                OPT_ENGINES=1
                ENGINES_QUERY="$2"
                shift ;;
            --keep-languages)
                [ -n "${2:-}" ] || { echo "$PROGNAME: --keep-languages requires a comma-separated list" >&2; exit 2; }
                mkdir -p "$CONFIG_DIR"
                KEEP_LANGUAGES=$(normalize_languages "$2")
                printf '%s\n' "$KEEP_LANGUAGES" > "$KEEP_LANGUAGES_FILE"
                if [ -n "$KEEP_LANGUAGES" ]; then
                    printf 'Keeping languages: %s (other language packs are removed by --slim)\n' "$KEEP_LANGUAGES"
                else
                    printf 'Language list cleared; --slim will leave language packs untouched.\n'
                fi
                exit 0 ;;
            --prune-assets|--prune-fallbacks)
                [ -n "${2:-}" ] || { echo "$PROGNAME: $1 requires a game name or path" >&2; exit 2; }
                OPT_PRUNE=1
                PRUNE_QUERY="$2"
                [ "$1" = --prune-fallbacks ] && PRUNE_FALLBACKS=1
                shift ;;
            -l|--library)
                if [ -z "$2" ]; then
                    echo "$PROGNAME: --library requires a directory" >&2
                    exit 2
                fi
                add_library_cli "$2"
                exit 0 ;;
            --pending)     OPT_PENDING_ONLY=1 ;;
            --history)     OPT_HISTORY=1 ;;
            --stats)       OPT_STATS=1 ;;
            --benchmark)   OPT_BENCHMARK=1 ;;
            --export-ratios) OPT_EXPORT=1 ;;
            --ratios)
                OPT_RATIOS=1
                # Optional game name: only consume it if it is not another flag.
                case "${2:-}" in
                    ""|-*) ;;
                    *) RATIOS_QUERY="$2"; shift ;;
                esac ;;
            --import-ratios)
                if [ -z "${2:-}" ]; then
                    echo "$PROGNAME: --import-ratios requires a JSON file" >&2
                    exit 2
                fi
                OPT_IMPORT=1; RATIOS_IMPORT_FILE="$2"; shift ;;
            --render-ratios) OPT_RENDER=1 ;;
            --balance)     OPT_BALANCE=1 ;;
            --check-update) OPT_CHECK_UPDATE=1 ;;
            --self-update) OPT_SELF_UPDATE=1 ;;
            --uninstall)   OPT_UNINSTALL=1 ;;
            --submit-ratios) OPT_SUBMIT_RATIOS=1 ;;
            --yes|-y)      OPT_YES=1 ;;
            --json)        OPT_JSON=1 ;;
            --notify)      OPT_NOTIFY=1 ;;
            --verbose)     OPT_VERBOSE=1 ;;
            --no-color)    OPT_NO_COLOR=1 ;;
            --)            shift; break ;;
            -*)            echo "$PROGNAME: unknown option '$1'" >&2
                           echo "Try '$PROGNAME --help'." >&2
                           exit 2 ;;
            *)             echo "$PROGNAME: unexpected argument '$1'" >&2
                           echo "Try '$PROGNAME --help'." >&2
                           exit 2 ;;
        esac
        shift
    done

    # Modes that run on their own and then exit. They are listed once here, with
    # the flag that opts in and whether --json is meaningful for that mode, so a
    # new mode cannot be added without stating its combination rules.
    #   name          flag variable              allows --json  human name
    local -a modes=(
        "OPT_STATUS:--status:1"
        "OPT_DRY_RUN:--dry-run:0"
        "OPT_DEDUPE:--dedupe:0"
        "OPT_RECHECK:--recheck:0"
        "OPT_ASSETS:--assets:0"
        "OPT_ASSET_INVENTORY:--asset-inventory:0"
        "OPT_ASSET_CONTAINERS:--asset-containers:0"
        "OPT_AUDIT_GAME_PACKS:--audit-game-packs:0"
        "OPT_AUDIT_GAME_FMOD:--audit-game-fmod:0"
        "OPT_ASSETS_ALL:--assets-all:0"
        "OPT_ASSETS_VERIFY_ALL:--assets-verify-all:0"
        "OPT_COMPACT_ALL:--compact-all-no-backup:0"
        "OPT_PRUNE:--prune-assets/--prune-fallbacks:0"
        "OPT_VARIANTS:--variants:0"
        "OPT_OPPORTUNITIES:--opportunities:0"
        "OPT_SLIM:--slim:0"
        "OPT_ENGINES:--engines:0"
        "OPT_FMOD_EXPORT:--export-fmod:0"
        "OPT_TEXTURE_COMPRESS:--texture-compress:0"
        "OPT_TEXTURE_COMPRESS_TREE:--texture-compress-tree:0"
        "OPT_CONTAINER:--audit-container/--audit-godot-textures/--audit-godot3-audio/--export-unityfs/--export-godot/--export-godot-textures/--export-godot3-audio:0"
        "OPT_BALANCE:--balance:0"
        "OPT_NOTIFY:--notify:0"
        "OPT_HISTORY:--history:0"
        "OPT_STATS:--stats:0"
        "OPT_BENCHMARK:--benchmark:1"
        "OPT_EXPORT:--export-ratios:0"
        "OPT_RATIOS:--ratios:1"
        "OPT_IMPORT:--import-ratios:0"
        "OPT_RENDER:--render-ratios:0"
        "OPT_CHECK_UPDATE:--check-update:0"
        "OPT_SELF_UPDATE:--self-update:0"
        "OPT_UNINSTALL:--uninstall:0"
        "OPT_SUBMIT_RATIOS:--submit-ratios:0"
    )
    local entry var flag jsonok selected="" selected_flag="" selected_json=0 count=0
    for entry in "${modes[@]}"; do
        var="${entry%%:*}"; entry="${entry#*:}"
        flag="${entry%%:*}"; jsonok="${entry##*:}"
        if [ "${!var}" -eq 1 ]; then
            count=$(( count + 1 ))
            [ "$count" -eq 1 ] && { selected="$var"; selected_flag="$flag"; selected_json="$jsonok"; }
        fi
    done
    if [ "$count" -gt 1 ]; then
        echo "$PROGNAME: these modes cannot be combined: $selected_flag and another mode" >&2
        echo "          Run one at a time. See '$PROGNAME --help'." >&2
        exit 2
    fi
    # --notify is a background mode: it must be the only thing asked for, so a
    # timer can never accidentally trigger a report or a write alongside it.
    if [ "$OPT_JSON" -eq 1 ] && { [ "$count" -eq 0 ] || [ "$selected_json" -eq 0 ]; }; then
        echo "$PROGNAME: --json requires --status, --benchmark or --ratios" >&2
        exit 2
    fi
    # --balance rewrites a whole filesystem; it can never ride along silently.
    if [ "$OPT_PENDING_ONLY" -eq 1 ] && [ "$OPT_STATUS" -ne 1 ] && [ "$OPT_DRY_RUN" -ne 1 ]; then
        echo "$PROGNAME: --pending only applies to --status or --dry-run" >&2
        exit 2
    fi
    if [ "$OPT_YES" -eq 1 ] && [ "$OPT_UNINSTALL" -ne 1 ] && [ "$OPT_SUBMIT_RATIOS" -ne 1 ]; then
        echo "$PROGNAME: --yes only applies to --uninstall or --submit-ratios" >&2
        exit 2
    fi

    if [ "$OPT_NO_COLOR" -eq 1 ] || [ -n "$NO_COLOR" ]; then
        disable_colors
    fi
}

# Percent-encode fields stored in the pipe-delimited state database. Encode %
# first so the escape sequences themselves remain unambiguous.
encode_field() {
    local value="${1//%/%25}"
    value="${value//|/%7C}"
    value="${value//$'\t'/%09}"
    value="${value//$'\n'/%0A}"
    value="${value//$'\r'/%0D}"
    printf '%s' "$value"
}

decode_field() {
    DECODED_FIELD="${1//%0D/$'\r'}"
    DECODED_FIELD="${DECODED_FIELD//%0A/$'\n'}"
    DECODED_FIELD="${DECODED_FIELD//%09/$'\t'}"
    DECODED_FIELD="${DECODED_FIELD//%7C/|}"
    DECODED_FIELD="${DECODED_FIELD//%25/%}"
}

# Quote an arbitrary Bash string as one JSON string value. Bytes outside the
# JSON control range (including UTF-8) pass through unchanged.
json_quote() {
    JSON_INPUT="$1" awk 'BEGIN {
        s = ENVIRON["JSON_INPUT"]
        printf "\""
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "\"") printf "\\\""
            else if (c == "\\") printf "\\\\"
            else {
                escaped = 0
                for (j = 1; j < 32; j++) {
                    if (c == sprintf("%c", j)) {
                        printf "\\u%04x", j
                        escaped = 1
                        break
                    }
                }
                if (!escaped) printf "%s", c
            }
        }
        printf "\""
    }'
}

# Tokenize quoted VDF strings and return values associated with a "path" key.
# Escaped quotes and backslashes are decoded, unlike grep-based extraction.
parse_vdf_libraries() {
    awk '
        function emit(token) {
            if (previous == "path") print token
            previous = token
        }
        {
            line = $0
            in_string = 0; escaped = 0; token = ""
            for (i = 1; i <= length(line); i++) {
                c = substr(line, i, 1)
                if (!in_string) {
                    if (c == "\"") { in_string = 1; token = "" }
                } else if (escaped) {
                    if (c == "\\" || c == "\"") token = token c
                    else token = token "\\" c
                    escaped = 0
                } else if (c == "\\") escaped = 1
                else if (c == "\"") { emit(token); in_string = 0 }
                else token = token c
            }
        }
    ' "$1"
}

add_library_cli() {
    local new_path="$1"
    new_path="${new_path/#\~/$HOME}"
    if [ -d "$new_path/steamapps/common" ]; then
        new_path="$new_path/steamapps/common"
    fi
    if [ ! -d "$new_path" ]; then
        echo "$PROGNAME: '$new_path' is not a directory" >&2
        exit 1
    fi
    local fs_type
    fs_type=$(stat -f -c %T "$new_path" 2>/dev/null || true)
    if [ "$fs_type" != "btrfs" ]; then
        echo "$PROGNAME: warning: '$new_path' is on '$fs_type', not btrfs" >&2
    fi
    mkdir -p "$CONFIG_DIR"
    touch "$CUSTOM_LIBS_FILE"
    if grep -qxF "$new_path" "$CUSTOM_LIBS_FILE" 2>/dev/null; then
        echo "Already registered: $new_path"
        return 0
    fi
    echo "$new_path" >> "$CUSTOM_LIBS_FILE"
    echo "Registered: $new_path"
}

init_paths() {
    mkdir -p "$CONFIG_DIR" "$STATE_DIR"
    touch "$STATE_FILE" "$CUSTOM_LIBS_FILE" "$DEDUPE_HISTORY_FILE" "$DEDUPE_COMPLETION_FILE"
    # The version header is written lazily, by the first real state_upsert, so a
    # read-only run (--status, --dry-run) still leaves the state file untouched.
    [ -f "$THROTTLE_FILE" ] || echo "0" > "$THROTTLE_FILE"
    [ -f "$MIN_SIZE_FILE" ] || echo "1" > "$MIN_SIZE_FILE"
    [ -f "$LEVEL_FILE" ] || echo "auto" > "$LEVEL_FILE"
    [ -f "$VISUAL_TARGET_FILE" ] || echo "native" > "$VISUAL_TARGET_FILE"
    [ -f "$KEEP_LANGUAGES_FILE" ] || : > "$KEEP_LANGUAGES_FILE"
    [ -f "$PCT_FILE" ] || echo "5" > "$PCT_FILE"
    [ -f "$DELETE_FILE" ] || echo "1" > "$DELETE_FILE"
    [ -f "$AUTO_UPDATE_FILE" ] || echo "1" > "$AUTO_UPDATE_FILE"
}

# Canonicalize a user language list ("en, de" / "English,German") into a
# lowercase comma-separated set of short codes. Order is preserved, duplicates
# removed. An empty result disables language pruning.
normalize_languages() {
    local raw="$1" out="" token
    raw="${raw//,/ }"
    for token in $raw; do
        token="${token,,}"
        case "$token" in
            ''|*[!a-z0-9-]*) continue ;;
        esac
        case ",$out," in *",$token,"*) ;; *) out="${out:+$out,}$token" ;; esac
    done
    printf '%s' "$out"
}

load_config() {
    MIN_SIZE_MIB=1
    COMPRESS_LEVEL=auto
    VISUAL_TARGET=native
    KEEP_LANGUAGES=""
    MIN_GAIN_PCT=5
    MIN_PRUNE_MIB=1
    AUTO_UPDATE=1
    local val

    if [ -f "$MIN_SIZE_FILE" ]; then
        read -r val < "$MIN_SIZE_FILE" 2>/dev/null || val=""
        if [[ "${val:-}" =~ ^[0-9]+$ ]]; then
            MIN_SIZE_MIB="$val"
        elif [ -n "${val:-}" ]; then
            echo "$PROGNAME: ignoring invalid value in $MIN_SIZE_FILE (expected a whole number of MiB)" >&2
        fi
    fi

    if [ -f "$LEVEL_FILE" ]; then
        read -r val < "$LEVEL_FILE" 2>/dev/null || val=""
        if [ "${val:-auto}" = "auto" ]; then
            COMPRESS_LEVEL=auto
        elif [[ "${val:-}" =~ ^[0-9]+$ ]] && [ "$val" -ge 1 ] && [ "$val" -le 15 ]; then
            COMPRESS_LEVEL="$val"
        elif [ -n "${val:-}" ]; then
            echo "$PROGNAME: ignoring invalid value in $LEVEL_FILE (expected 'auto' or 1-15)" >&2
        fi
    fi

    if [ -f "$VISUAL_TARGET_FILE" ]; then
        read -r val < "$VISUAL_TARGET_FILE" 2>/dev/null || val=""
        case "$val" in
            native|lossless|ultra-performance|performance|balanced|quality|ultra-quality) VISUAL_TARGET="$val" ;;
            *) echo "$PROGNAME: ignoring invalid visual target in $VISUAL_TARGET_FILE" >&2 ;;
        esac
    fi

    if [ -f "$KEEP_LANGUAGES_FILE" ]; then
        read -r val < "$KEEP_LANGUAGES_FILE" 2>/dev/null || val=""
        KEEP_LANGUAGES=$(normalize_languages "$val")
        if [ -n "${val:-}" ] && [ -z "$KEEP_LANGUAGES" ]; then
            echo "$PROGNAME: ignoring invalid languages in $KEEP_LANGUAGES_FILE (expected codes or names, e.g. en,de)" >&2
        fi
    fi

    if [ -f "$PCT_FILE" ]; then
        read -r val < "$PCT_FILE" 2>/dev/null || val=""
        if [[ "${val:-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            MIN_GAIN_PCT="$val"
        elif [ -n "${val:-}" ]; then
            echo "$PROGNAME: ignoring invalid value in $PCT_FILE (expected a percentage)" >&2
        fi
    fi

    if [ -f "$DELETE_FILE" ]; then
        read -r val < "$DELETE_FILE" 2>/dev/null || val=""
        if [[ "${val:-}" =~ ^[0-9]+$ ]]; then
            MIN_PRUNE_MIB="$val"
        elif [ -n "${val:-}" ]; then
            echo "$PROGNAME: ignoring invalid value in $DELETE_FILE (expected a whole number of MiB)" >&2
        fi
    fi

    if [ -f "$AUTO_UPDATE_FILE" ]; then
        read -r val < "$AUTO_UPDATE_FILE" 2>/dev/null || val=""
        case "${val:-1}" in
            0) AUTO_UPDATE=0 ;;
            1) AUTO_UPDATE=1 ;;
            *) echo "$PROGNAME: ignoring invalid value in $AUTO_UPDATE_FILE (expected 0 or 1)" >&2 ;;
        esac
    fi
}

require_dependencies() {
    local missing=0 dep
    for dep in awk find sed stat du date grep sort cut mktemp mv; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "$PROGNAME: required command not found: $dep" >&2
            missing=1
        fi
    done
    if [ "$missing" -eq 1 ]; then
        exit 1
    fi
    return 0
}

native_backend() {
    if [ -n "${BTRFS_GAME_COMPRESSOR_BACKEND:-}" ]; then
        printf '%s\n' "$BTRFS_GAME_COMPRESSOR_BACKEND"
        return
    fi
    local dir
    dir=$(dirname "$(self_script_path)")
    printf '%s/bgc-native\n' "$dir"
}

require_btrfs() {
    local backend
    backend=$(native_backend)
    if [ ! -x "$backend" ] || [ "$("$backend" --protocol-version 2>/dev/null)" != 1 ]; then
        printf '%s: matching bundled bgc-native backend is missing or incompatible.\n' "$PROGNAME" >&2
        printf 'Reinstall the complete release, or run make native in a source checkout.\n' >&2
        exit 1
    fi
}

detect_platform() {
    local os_release="${BTRFS_GAME_COMPRESSOR_OS_RELEASE:-/etc/os-release}"
    local id="" variant="" id_like=""
    if [ -r "$os_release" ]; then
        id=$(sed -n 's/^ID=//p' "$os_release" 2>/dev/null | tr -d '"' | head -n 1)
        variant=$(sed -n 's/^VARIANT_ID=//p' "$os_release" 2>/dev/null | tr -d '"' | head -n 1)
        id_like=$(sed -n 's/^ID_LIKE=//p' "$os_release" 2>/dev/null | tr -d '"' | head -n 1)
    fi
    case "$id" in
        steamos)   PLATFORM="steamos" ;;
        cachyos)   PLATFORM="cachyos" ;;
        bazzite)   PLATFORM="bazzite" ;;
        fedora)    PLATFORM="fedora" ;;
        arch)      PLATFORM="arch" ;;
        ubuntu)    PLATFORM="ubuntu" ;;
        debian)    PLATFORM="debian" ;;
        opensuse*|sled*) PLATFORM="opensuse" ;;
        *)         PLATFORM="other" ;;
    esac
    # ID_LIKE fallback for derivatives (e.g. Pop!_OS -> ubuntu, EndeavourOS -> arch)
    if [ "$PLATFORM" = "other" ] && [ -n "$id_like" ]; then
        case "$id_like" in
            *ubuntu*)  PLATFORM="ubuntu" ;;
            *debian*)  PLATFORM="debian" ;;
            *fedora*)  PLATFORM="fedora" ;;
            *arch*)    PLATFORM="arch" ;;
            *opensuse*|*sled*) PLATFORM="opensuse" ;;
        esac
    fi
    [ "$variant" = "steamdeck" ] && PLATFORM="steamdeck"
    return 0
}

is_removable_media() {
    local mp
    mp=$(findmnt -no MAJ:MIN --target "${1:-/}" 2>/dev/null || true)
    [ -n "$mp" ] || return 1
    [ "$(cat "/sys/dev/block/$mp/removable" 2>/dev/null || echo 0)" = "1" ]
}

suggested_level() {
    if is_removable_media "${1:-/}"; then
        echo 6
    else
        echo 3
    fi
}

# Parse a comma-separated mount option list and echo the zstd level it implies.
# Fails when the options do not enable zstd.
# btrfs spells the option 'compress-force' (hyphen); both it and the
# 'compress' form are honoured, and compress-force takes precedence.
parse_zstd_level() {
    local opts="${1:-}" spec chosen="" level
    [ -n "$opts" ] || return 1

    for spec in $(printf '%s' "$opts" | tr ',' ' '); do
        case "$spec" in
            compress-force=zstd|compress-force=zstd:*) chosen="$spec" ;;
        esac
    done
    if [ -z "$chosen" ]; then
        for spec in $(printf '%s' "$opts" | tr ',' ' '); do
            case "$spec" in
                compress=zstd|compress=zstd:*) chosen="$spec" ;;
            esac
        done
    fi
    [ -n "$chosen" ] || return 1

    level="${chosen#*:}"
    [ "$level" = "$chosen" ] && level=3
    case "$level" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s' "$level"
}

# Echo the zstd level in effect for the filesystem containing $1.
mount_zstd_level() {
    local opts
    opts=$(findmnt -no OPTIONS --target "${1:-/}" 2>/dev/null || true)
    parse_zstd_level "$opts"
}

# Resolve the explicit ZSTD level requested through the native backend.
# A configured level always wins; 'auto' mirrors the filesystem's own level
# so that a library stays uniformly compressed.
effective_level() {
    local target="${1:-/}"
    if [ "$COMPRESS_LEVEL" != "auto" ]; then
        printf '%s' "$COMPRESS_LEVEL"
        return 0
    fi
    local mount_lvl
    mount_lvl=$(mount_zstd_level "$target" || true)
    printf '%s' "${mount_lvl:-3}"
}

check_compress_mount() {
    local lib="$1" mountpoint opts level
    mountpoint=$(findmnt -no TARGET --target "$lib" 2>/dev/null || true)
    [ -z "$mountpoint" ] && return 0
    opts=$(findmnt -no OPTIONS --target "$lib" 2>/dev/null || true)
    level=$(mount_zstd_level "$lib" || true)
    [ -n "$level" ] && return 0

    case ",$opts," in
        *,compress-force=*,*|*,compress=*,*)
            echo "$PROGNAME: warning: '$mountpoint' compresses, but not with zstd." >&2
            ;;
        *)
            echo "$PROGNAME: warning: '$mountpoint' has no compress= mount option." >&2
            echo "                Nothing written here will be compressed until you enable it:" >&2
            ;;
    esac
    if [ "$COMPRESS_LEVEL" = "auto" ]; then
        echo "                defragment will still use zstd level $(suggested_level "$lib") for this run." >&2
    else
        echo "                defragment will still use zstd level $COMPRESS_LEVEL for this run." >&2
    fi
    echo "                Persist it across reboots with a matching mount option, e.g.:" >&2
    echo "                  compress-force=zstd:$(suggested_level "$lib")" >&2
    return 0
}

cleanup() {
    if [ "$TUI_ACTIVE" -eq 1 ]; then
        tput cnorm 2>/dev/null
        printf '\033[?25h' 2>/dev/null
    fi
