VISUAL_TARGET_FILE="$CONFIG_DIR/visual_target"
KEEP_LANGUAGES_FILE="$CONFIG_DIR/keep_languages"
PCT_FILE="$CONFIG_DIR/min_gain_pct"
DELETE_FILE="$CONFIG_DIR/min_prune_mib"
AUTO_UPDATE_FILE="$CONFIG_DIR/auto_update"
DEDUPE_HASH_DIR="$STATE_DIR/dedupe"
