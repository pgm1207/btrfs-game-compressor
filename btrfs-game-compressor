    exec python3 "$runner" --repo "$(dirname "$(readlink -f "$0")")" \
        --state-dir "${XDG_STATE_HOME:-$HOME/.local/state}/btrfs-game-compressor/compact-balanced" \
        --apply-assets-no-backup
