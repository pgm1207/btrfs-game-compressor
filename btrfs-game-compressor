KEY=""

# Canonical Enter. Terminals deliver CR (0x0d); some deliver LF. Both select the
# highlighted item / confirm, so callers never have to special-case Enter.
KEY_ENTER=$'\r'

read_input() {
    KEY=""
    local lead="" final=""
    if ! IFS= read -rsn1 KEY 2>/dev/null; then
        KEY=""
        return 1
    fi
    if [ "$KEY" = $'\x1b' ]; then
        if read -rsn1 -t 0.25 lead 2>/dev/null; then
            case "$lead" in
                "["|"O") read -rsn1 -t 0.25 final 2>/dev/null ;;
                *) final="$lead" ;;
            esac
            KEY="$KEY$lead$final"
        fi
    fi
    if [ "$KEY" = $'\n' ]; then
        KEY="$KEY_ENTER"
    fi
    return 0
}

drain_pending_input() {
    local junk=""
    while read -rsn1 -t 0.05 junk 2>/dev/null; do :; done
    return 0
}

to_mib() {
    local val="$1"
    echo "$val" | awk '{
        n = $1; gsub(/[^0-9.]/, "", n);
        u = toupper($0);
        if (index(u, "G")) print int(n * 1024);
        else if (index(u, "M")) print int(n);
        else if (index(u, "K")) print int(n / 1024);
        else if (index(u, "T")) print int(n * 1024 * 1024);
        else print int(n / (1024*1024));
    }'
}

game_index_by_path() {
    local want="$1" i
    while [[ "$want" == */ && "$want" != "/" ]]; do want="${want%/}"; done
    for i in "${!GAMES_PATH[@]}"; do
        local have_path="${GAMES_PATH[$i]}"
        while [[ "$have_path" == */ && "$have_path" != "/" ]]; do have_path="${have_path%/}"; done
        if [ "$have_path" = "$want" ]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

# Emit current logical bytes and separate newer-than-compression / newer-than-dedupe flags.
# The human size is also formatted here to avoid another process per game.
scan_game_dir() {
    local target="$1" since="${2:-0}" dedupe_since="${3:-0}"
    find "$target" -path "$target/.bgc-assets-backup" -prune -o \
        \( -type f -printf 'f %s %T@\n' \) -o \( -type d -printf 'd 0 %T@\n' \) 2>/dev/null |
        awk -v since="$since" -v dedupe_since="$dedupe_since" '
            $1 == "f" { bytes += $2; files++ }
            $3 + 0 > since + 0 { newer = 1 }
            ($3 + 0) * 1000000000 > dedupe_since + 0 { dedupe_newer = 1 }
            END {
                hum = bytes + 0
                if (hum < 1024) {
                    human = sprintf("%dB", hum)
                } else {
                    units = "KMGTPE"
                    i = 0
                    while (hum >= 1024 && i < 5) { hum /= 1024; i++ }
                    human = sprintf("%.1f%c", hum, substr(units, i, 1))
                }
                printf "%d %d %d %s %d\n", bytes + 0, files + 0, newer + 0, human, dedupe_newer + 0
            }
        '
}

is_ignored() {
    case "$1" in
        SteamLinuxRuntime*|"Steamworks Shared"|"Steam Controller Configs"|Proton*) return 0 ;;
        *) return 1 ;;
    esac
}

# Populate RUNNING_DIRS with the install paths that a live process has
# mapped, so that a pass never defragments a game somebody is playing.
#
# This deliberately does NOT read Steam's appmanifest StateFlags. It is an
# undocumented bit field, and the two most credible public references disagree
# about which bit means "running": Lutris documents StateAppRunning as 64, while
# the reverse-engineered Valve SDK header (SteamStructs/EAppState.h) says 8192.
# Guessing wrong in one direction compresses a live game, so instead of
# interpreting the field, this asks the kernel a question that has only one
# answer - does any live process have files from that directory mapped in?
#
# Reading /proc/<pid>/maps rather than /proc/<pid>/exe matters: a Proton game
# is a Windows binary executed by wine, so its /proc/exe points at the wine
# loader and never at the game. The loader does map the game's own files though,
# so this catches native and Proton games alike.
#
# One awk pass over /proc, so the cost does not scale with the library size.
discover_running_games() {
    RUNNING_DIRS=()
    [ "${#LIBS[@]}" -gt 0 ] || return 0

    local pids="" pid libs
    for pid in /proc/[0-9]*; do
        pid=${pid#/proc/}
        pids="$pids $pid"
    done
    [ -n "$pids" ] || return 0

    libs=$(printf '%s\n' "${LIBS[@]}")

    while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        RUNNING_DIRS["$dir"]=1
    done < <(awk -v pids="$pids" -v libs="$libs" '
        BEGIN {
            np = split(pids, P, " ")
            nl = split(libs, L, "\n")
            for (i = 1; i <= np; i++) {
                path = "/proc/" P[i] "/maps"
                while ((getline line < path) > 0) {
                    # /proc/PID/maps escapes whitespace and backslashes in
                    # filenames. Decode those before comparing with library
                    # paths supplied by the user and filesystem.
                    gsub(/\\134/, "\\\\", line)
                    gsub(/\\040/, " ", line)
                    gsub(/\\011/, "\t", line)
                    gsub(/\\012/, "\n", line)
                    # The path is at the end of a maps line. Require a slash
                    # after the library root so /mnt/games does not also match
                    # /mnt/games2, then emit the full install directory path.
                    for (j = 1; j <= nl; j++) {
                        pref = L[j] "/"
                        if (index(line, pref) == 0) continue
                        rest = substr(line, index(line, pref) + length(pref))
                        split(rest, seg, "/")
                        game = L[j] "/" seg[1]
                        if (!(game in seen)) {
                            seen[game] = 1
                            print game
                        }
                    }
                }
                close(path)
            }
        }' 2>/dev/null)
    return 0
}

game_is_running() {
    # An empty subscript is a hard error in bash, not a lookup miss, so the
    # empty name has to be rejected before it reaches the array.
    local path="${1:-}"
    [ -n "$path" ] || return 1
    while [[ "$path" == */ && "$path" != "/" ]]; do path="${path%/}"; done
    [ -n "${RUNNING_DIRS["$path"]:-}" ]
}

get_cmd_prefix() {
    local mode
    mode=$(cat "$THROTTLE_FILE" 2>/dev/null || echo "0")
    if [ "$mode" = "1" ]; then
        echo "nice -n 19 ionice -c 2 -n 7"
    else
        echo ""
    fi
}

compress_directory() {
    local target="$1" prefix level
    prefix=$(get_cmd_prefix)
    level=$(effective_level "$target")
    if [ -n "$prefix" ]; then
        $prefix "$(native_backend)" compress "$level" "$target"
    else
        "$(native_backend)" compress "$level" "$target"
    fi
}

# FIEMAP reports logical mapped ranges and whether their extents are shared.
# The exclusive-byte delta is a logical sharing estimate, not disk space freed.
btrfs_usage_raw() {
    local output="$1"
    printf '%s\n' "$output" | awk '$1 ~ /^[0-9]+$/ { print $1 "|" $2 "|" $3; found=1; exit } END { if (!found) exit 1 }'
}

btrfs_usage_for() {
    local path="$1" output
    output=$("$(native_backend)" usage "$path" 2>/dev/null) || return 1
    [[ "$output" =~ ^[0-9]+\|[0-9]+\|[0-9]+$ ]] || return 1
    printf '%s\n' "$output"
}

# Return exact unique data-extent bytes. Btrfs restricts this metadata query to
# privileged callers; when sudo has no cached credentials, show savings as unknown.
run_measure_bytes() {
    local output
    if [ "$EUID" -eq 0 ]; then
        output=$("$(native_backend)" measure-bytes "$1" 2>/dev/null) || return 1
    else
        output=$(sudo -n -- "$(native_backend)" measure-bytes "$1" 2>/dev/null) || return 1
    fi
    [[ "$output" =~ ^[0-9]+\|[0-9]+\|[0-9]+$ ]] || return 1
    printf '%s\n' "$output"
}

load_dedupe_completions() {
    DEDUPE_MAP=()
    local stamp encoded path
    [ -r "$DEDUPE_COMPLETION_FILE" ] || return 0
    while IFS='|' read -r stamp encoded; do
        [[ "$stamp" =~ ^[0-9]+$ ]] && [ -n "$encoded" ] || continue
        decode_field "$encoded"
        path="$DECODED_FIELD"
        [ -n "$path" ] || continue
        if [ "$stamp" -gt "${DEDUPE_MAP[$path]:-0}" ]; then
            DEDUPE_MAP["$path"]="$stamp"
        fi
    done < "$DEDUPE_COMPLETION_FILE"
}

record_dedupe_completion() {
    local path="$1" encoded stamp lockfile="$DEDUPE_COMPLETION_FILE.lock"
    encoded=$(encode_field "$path")
    stamp=$(date +%s%N)
    exec 7>>"$lockfile" || return 1
    flock -x 7 || { exec 7>&-; return 1; }
    printf '%s|%s\n' "$stamp" "$encoded" >> "$DEDUPE_COMPLETION_FILE"
    local rc=$?
    flock -u 7 2>/dev/null || true
    exec 7>&-
    [ "$rc" -eq 0 ] || return "$rc"
    DEDUPE_MAP["$path"]="$stamp"
    DEDUPE_COMPLETION_RECORDED=1
    return 0
}

record_dedupe_measurement() {
    local common="$1" before="$2" after="$3" saved="$4"
    local bt be bs at ae as encoded value
    [ -n "$before" ] && [ -n "$after" ] || return 0
    bt="${before%%|*}"; before="${before#*|}"; be="${before%%|*}"; bs="${before#*|}"
    at="${after%%|*}"; after="${after#*|}"; ae="${after%%|*}"; as="${after#*|}"
    for value in "$bt" "$be" "$bs" "$at" "$ae" "$as"; do
        [[ "$value" =~ ^[0-9]+$ ]] || return 1
    done
    [[ "$saved" =~ ^-?[0-9]+$ ]] || return 1
    encoded=$(encode_field "$common")
    # The record is a single append write. A truncated final line is ignored by
    # readers, and a separate lock serializes appends from different libraries.
    exec 8>>"$DEDUPE_HISTORY_FILE.lock" || return 1
    flock -x 8 || { exec 8>&-; return 1; }
    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$(date +%s)" "$encoded" "$bt" "$be" "$bs" "$at" "$ae" "$as" "$saved" >> "$DEDUPE_HISTORY_FILE"
    local rc=$?
    flock -u 8 2>/dev/null || true
    exec 8>&-
    return "$rc"
}

# A library lock serializes automatic game passes and manual library passes.
# The native backend creates bounded temporary indexes for exactly this scope.
dedupe_game() {
    local game_path="$1" measure="${2:-0}" common="${3:-}" hash hashfile prefix running_path before after
    local rc lockfile scope_hash logfile
    local -a pipeline_status dedupe_cmd
    [ -n "$common" ] || common="${game_path%/*}"
    DEDUPE_RESULT=error
    DEDUPE_COMPLETION_RECORDED=0
    DEDUPE_SAVED_BYTES=0
    DEDUPE_MEASURED=0
    DEDUPE_BEFORE_USAGE=""
    DEDUPE_AFTER_USAGE=""
    DEDUPE_HISTORY_ERROR=0
    DEDUPE_BEFORE_PHYSICAL=""
    DEDUPE_AFTER_PHYSICAL=""
    [ -x "$(native_backend)" ] || { DEDUPE_RESULT=unavailable; return 1; }
    command -v flock >/dev/null 2>&1 || { DEDUPE_RESULT=lock_unavailable; return 1; }

    discover_running_games
    for running_path in "${!RUNNING_DIRS[@]}"; do
        if [[ "$running_path" == "$game_path" || "$running_path" == "$game_path"/* ]]; then
            DEDUPE_RESULT=running
            return 2
        fi
    done

    mkdir -p "$DEDUPE_HASH_DIR" 2>/dev/null || return 1
    hash=$(printf '%s' "$common" | sha256sum | awk '{print $1}')
    [ -n "$hash" ] || return 1
    scope_hash=$(printf '%s' "$game_path" | sha256sum | awk '{print $1}')
    # Scope-specific log; legacy databases are neither read nor modified.
    hashfile="$DEDUPE_HASH_DIR/native-$scope_hash"
    lockfile="$DEDUPE_HASH_DIR/$hash.db.lock"
    exec 9>>"$lockfile" || { DEDUPE_RESULT=error; return 1; }
    if ! flock -n 9; then
        exec 9>&-
        DEDUPE_RESULT=locked
        return 3
    fi
    if [ "$measure" -eq 1 ]; then
        before=$(btrfs_usage_for "$game_path" || true)
        DEDUPE_BEFORE_PHYSICAL=$(run_measure_bytes "$game_path" || true)
    else
        before=""
    fi
    DEDUPE_BEFORE_USAGE="$before"
    prefix=$(get_cmd_prefix)
    logfile="$hashfile.log"
    printf 'Checking duplicate data in %s (sector-aligned blocks)...\n' "$game_path" >&2
    dedupe_cmd=("$(native_backend)" dedupe "$game_path" "$DEDUPE_HASH_DIR")
    # Stream progress; command substitution used to hide all output until exit.
    # Save both statuses immediately: tee must not hide native failures.
    if [ -n "$prefix" ]; then
        $prefix "${dedupe_cmd[@]}" 2>&1 | tee "$logfile" >&2
        pipeline_status=("${PIPESTATUS[@]}")
    else
        "${dedupe_cmd[@]}" 2>&1 | tee "$logfile" >&2
        pipeline_status=("${PIPESTATUS[@]}")
    fi
    rc=${pipeline_status[0]}
    if [ "$rc" -eq 130 ] || [ "$rc" -eq 143 ]; then
        flock -u 9 2>/dev/null || true
        exec 9>&-
        return "$rc"
    fi
    [ "${pipeline_status[1]}" -eq 0 ] || rc=1
    if [ "$measure" -eq 1 ]; then
        after=$(btrfs_usage_for "$game_path" || true)
        DEDUPE_AFTER_PHYSICAL=$(run_measure_bytes "$game_path" || true)
    else
        after=""
    fi
    DEDUPE_AFTER_USAGE="$after"
    if [ -n "$DEDUPE_BEFORE_PHYSICAL" ] && [ -n "$DEDUPE_AFTER_PHYSICAL" ]; then
        local before_physical="${DEDUPE_BEFORE_PHYSICAL%%|*}" after_physical="${DEDUPE_AFTER_PHYSICAL%%|*}"
        DEDUPE_MEASURED=1
        DEDUPE_SAVED_BYTES=$((before_physical - after_physical))
        if [ "$rc" -eq 0 ] && ! record_dedupe_measurement "$game_path" "$DEDUPE_BEFORE_PHYSICAL" "$DEDUPE_AFTER_PHYSICAL" "$DEDUPE_SAVED_BYTES"; then
            DEDUPE_HISTORY_ERROR=1
        fi
    fi
    flock -u 9 2>/dev/null || true
    exec 9>&-
    if [ "$rc" -ne 0 ]; then
        DEDUPE_RESULT=error
        return 1
    fi
    if ! record_dedupe_completion "$game_path"; then
        printf 'Warning: dedupe completed, but its completion state could not be saved.\n' >&2
    fi
    DEDUPE_RESULT=done
    return 0
}

print_dedupe_summary() {
    local common="$1"
    if [ -n "$DEDUPE_BEFORE_PHYSICAL" ] && [ -n "$DEDUPE_AFTER_PHYSICAL" ]; then
        local before_bytes="${DEDUPE_BEFORE_PHYSICAL%%|*}" after_bytes="${DEDUPE_AFTER_PHYSICAL%%|*}"
        local original_bytes compression_saved final_saved final_pct dedupe_saved="${DEDUPE_SAVED_BYTES:-0}"
        original_bytes="${COMPRESS_ORIGINAL_BYTES:-}"
        if [ "${COMPRESS_REPORT_PATH:-}" != "$common" ] || ! [[ "$original_bytes" =~ ^[0-9]+$ ]] || [ "$original_bytes" -le 0 ]; then
            original_bytes=$(logical_game_bytes "$common")
        fi
        if [[ "$original_bytes" =~ ^[0-9]+$ ]] && [ "$original_bytes" -gt 0 ]; then
            compression_saved=$((original_bytes - before_bytes))
            final_saved=$((original_bytes - after_bytes))
            final_pct=$(awk -v a="$original_bytes" -v b="$after_bytes" 'BEGIN {printf "%.1f%%", (a-b)*100/a}')
            printf '%bFINAL GAME SIZE%b — %s\n  Original files: %s · Before dedupe: %s · After dedupe: %s\n  Saved before dedupe (compression/current footprint): %s · Dedupe saved this pass: %s\n  Total saved vs original: %s (%s)\n' \
                "$CYAN" "$RESET" "$common" "$(bytes_human "$original_bytes")" \
                "$(bytes_human "$before_bytes")" "$(bytes_human "$after_bytes")" \
                "$(bytes_human "$compression_saved")" "$(bytes_human "$dedupe_saved")" \
                "$(bytes_human "$final_saved")" "$final_pct"
        else
            printf '%bDEDUPLICATION%b — %s\n  Data extents: %s → %s · game data saved: %s\n' \
                "$CYAN" "$RESET" "$common" "$(bytes_human "$before_bytes")" \
                "$(bytes_human "$after_bytes")" "$(bytes_human "$dedupe_saved")"
        fi
    else
        printf '%bDEDUPLICATION%b — %s\n  Savings unknown: before/after extent measurement unavailable (requires sudo).\n' "$CYAN" "$RESET" "$common"
    fi
    printf '  Savings measure the game data footprint; snapshots or other references may retain space. Negative savings mean growth.\n'
    if [ "${DEDUPE_HISTORY_ERROR:-0}" -eq 1 ]; then
        printf '%bWarning:%b could not append this measurement to dedupe history.\n' "$YELLOW" "$RESET" >&2
    fi
}

# Shared runner for single-game, batch, and explicit dedupe operations. All
# arguments are game or steamapps/common paths; duplicates are coalesced here.
run_dedupe_paths() {
    local label="$1" game_path common library_common saved=0 scanned=0 skipped=0 failed=0 unknown=0 lib path rc
    shift
    local -A seen=()
    [ "$#" -gt 0 ] || return 0
    if [ -n "$label" ]; then
        echo
        echo '================================================================================'
        printf '  %s\n' "$label"
        echo '================================================================================'
    fi
    require_btrfs
    for path in "$@"; do
        while [[ "$path" == */ && "$path" != "/" ]]; do path="${path%/}"; done
        game_path="$path"
        common="${game_path%/*}"
        library_common="$common"
        for lib in "${LIBS[@]}"; do
            if [ "$game_path" = "$lib" ]; then
                library_common="$lib"
                break
            fi
        done
        [ -z "${seen[$game_path]:-}" ] || continue
        seen["$game_path"]=1
        dedupe_game "$game_path" 1 "$library_common"; rc=$?
        if [ "$rc" -eq 130 ] || [ "$rc" -eq 143 ]; then
            printf 'Deduplication interrupted; remaining paths were not scanned.\n' >&2
            return "$rc"
        fi
        if [ "$rc" -ne 0 ]; then
            case "$DEDUPE_RESULT" in
                running)
                    printf 'Skipped %s: the game is running.\n' "$game_path"
                    skipped=$((skipped + 1)) ;;
                locked)
                    printf 'Skipped %s: another process is deduplicating this library.\n' "$game_path"
                    skipped=$((skipped + 1)) ;;
                lock_unavailable)
                    printf 'Skipped %s: flock is required to serialize library deduplication.\n' "$game_path" >&2
                    failed=$((failed + 1)) ;;
                *)
                    printf 'Deduplication failed for %s.\n' "$game_path" >&2
                    if [ "${DEDUPE_MEASURED:-0}" -eq 1 ]; then
                        saved=$((saved + DEDUPE_SAVED_BYTES))
                    else
                        unknown=$((unknown + 1))
                    fi
                    print_dedupe_summary "$game_path"
                    failed=$((failed + 1)) ;;
            esac
            continue
        fi
        scanned=$((scanned + 1))
        if [ "${DEDUPE_MEASURED:-0}" -eq 1 ]; then
            saved=$((saved + DEDUPE_SAVED_BYTES))
        else
            unknown=$((unknown + 1))
        fi
        print_dedupe_summary "$game_path"
    done
    COMPRESS_REPORT_PATH=""
    local saved_label
    saved_label=$(bytes_human "$saved")
    [ "$unknown" -eq 0 ] || saved_label="unknown ($unknown unmeasured pass(es); $saved_label measured subtotal)"
    printf 'Deduplication totals: %d scan(s) completed · %d skipped · %d failed · %s game data saved\n' \
        "$scanned" "$skipped" "$failed" "$saved_label"
    [ "$failed" -eq 0 ]
}

cmd_dedupe() {
    require_btrfs
    if [ "${#LIBS[@]}" -eq 0 ]; then
        echo "No Btrfs Steam libraries found. Nothing to deduplicate."
        return 0
    fi
    run_dedupe_paths 'DEDUPLICATION' "${LIBS[@]}"
}

cmd_recheck() {
    local path name measured total original disk_bytes original_mib disk_mib saved_mib saved_label pct stamp encoded
    local checked=0 failed=0
    ensure_sudo
    printf 'Refreshing current game measurements; no files will be recompressed.\n'
    for path in "${GAMES_PATH[@]}"; do
        name="${path##*/}"
        measured=$(run_compsize "$path" || true)
        total=$(printf '%s\n' "$measured" | awk '/^TOTAL/ {print; exit}')
        original=$(logical_game_bytes "$path")
        disk_bytes=$(printf '%s\n' "$total" | awk '{print $6}')
        if [ -z "$total" ] || ! [[ "$disk_bytes" =~ ^[0-9]+$ ]] || ! [[ "$original" =~ ^[0-9]+$ ]]; then
            printf '  %-32s measurement unavailable; existing record kept.\n' "$name"
            failed=$((failed + 1))
            continue
        fi
        original_mib=$((original / 1048576))
        disk_mib=$((disk_bytes / 1048576))
        saved_mib=$((original_mib - disk_mib))
        saved_label=$(bytes_human "$((original - disk_bytes))")
        pct=$(awk -v a="$original" -v b="$disk_bytes" 'BEGIN { if (a>0) printf "%.1f%%", (a-b)*100/a; else print "n/a" }')
        stamp="${STATE_MAP[$path]:-}"
        if [ -z "$stamp" ]; then
            printf '  %-32s Current: %s · On disk: %s · not marked compressed\n' "$name" "$(bytes_human "$original")" "$(bytes_human "$disk_bytes")"
            checked=$((checked + 1))
            continue
        fi
        encoded=$(encode_field "$path")
        if state_upsert "$encoded" "$(printf '%s|%s|%s|%s|%s|%s|%s|%s|%s' "$encoded" "$name" "$stamp" "$(bytes_human "$original")" "$(bytes_human "$disk_bytes")" "$saved_label" "$saved_mib" "$original_mib" "$disk_mib")"; then
            printf '  %-32s Original: %s · On disk: %s · Saved: %s (%s) · compression date kept\n' "$name" "$(bytes_human "$original")" "$(bytes_human "$disk_bytes")" "$saved_label" "$pct"
            checked=$((checked + 1))
        else
            printf '  %-32s could not update saved measurement.\n' "$name" >&2
            failed=$((failed + 1))
        fi
    done
    printf 'Rechecked %d game(s); %d measurement(s) unavailable or not saved.\n' "$checked" "$failed"
    [ "$failed" -eq 0 ]
}

run_compsize() {
    if [ "$EUID" -eq 0 ]; then
        "$(native_backend)" measure "$@" 2>/dev/null
    else
        sudo -n -- "$(native_backend)" measure "$@" 2>/dev/null
    fi
}

check_compsize() {
    if [ "$COMPSIZE_OK" -ne -1 ]; then
        return
    fi
    if [ -x "$(native_backend)" ]; then
        COMPSIZE_OK=1
    else
        COMPSIZE_OK=0
        echo -e "${YELLOW}Warning: bundled native backend not found - savings stats will be unavailable.${RESET}" >&2
    fi
}

ensure_sudo() {
    check_compsize
    if [ "$COMPSIZE_OK" -eq 1 ] && [ "$EUID" -ne 0 ]; then
        if ! sudo -n true 2>/dev/null; then
            echo -e "${YELLOW}sudo access is required to read Btrfs compression metadata...${RESET}"
            sudo -v
        fi
    fi
}

# Copy the current state aside before it is replaced. Cheap insurance: a bad
# record or an interrupted write should never cost the user their whole history.
# The path is derived from STATE_FILE at call time rather than fixed at startup,
# so it always sits next to the file actually being written.
backup_state() {
    [ -s "$STATE_FILE" ] || return 0
    cp -p "$STATE_FILE" "${STATE_FILE}.bak" 2>/dev/null || true
    return 0
}

state_upsert() {
    local key="$1" rec="$2"
    local tmp
    tmp=$(mktemp "$STATE_DIR/.games.db.XXXXXX" 2>/dev/null) || return 1
    # Preserve the header (which carries no '|' and so never matches a key) and
    # any other comment, while replacing the record for this key.
    if ! awk -F'|' -v k="$key" '
        function canonical_path(p) { while (p != "/" && p ~ /\/$/) sub(/\/$/, "", p); return p }
        /^#/ { print; next }
        canonical_path($1) != canonical_path(k)
    ' \
            "$STATE_FILE" > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi
    if ! grep -q '^#' "$tmp" 2>/dev/null; then
        # Never write a file without its version header, or the next release
        # cannot tell which format it is reading.
        local tmp2="${tmp}.hdr"
        printf '%s\n' "$STATE_HEADER" > "$tmp2" 2>/dev/null && cat "$tmp" >> "$tmp2" 2>/dev/null && mv -f "$tmp2" "$tmp" 2>/dev/null
        rm -f "$tmp2"
    fi
    printf '%s\n' "$rec" >> "$tmp"
    backup_state
    mv -f "$tmp" "$STATE_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

logical_game_bytes() {
    find "$1" -path "$1/.bgc-assets-backup" -prune -o -type f -printf '%D %i %s\n' 2>/dev/null | awk '
        !seen[$1 ":" $2]++ { total += $3 }
        END { printf "%.0f\n", total + 0 }
    '
}

save_summary_record() {
    local name="$1"
    local path="$2"
    # Initialised empty: the script itself does not run with `set -u`, but the
    # test harness does, and an unset local referenced before assignment makes
    # the whole suite abort.
    local after_raw="" after_total="" a_pct="" a_disk="" a_uncomp="" a_disk_bytes="" a_raw_bytes=""
    local u_mib=0 d_mib=0 s_mib=0 saved_str="" record=0 a_uncomp_bytes=0 saved_bytes=0

    name="${name//|/ }"
    local state_path
    state_path=$(encode_field "$path")

    if [ "$COMPSIZE_OK" -eq 1 ]; then
        after_raw=$(run_compsize "$path" || true)
        after_total=$(echo "$after_raw" | grep "^TOTAL" || true)
    fi

    if [ -n "$after_total" ]; then
        a_disk=$(echo "$after_total" | awk '{print $3}')
        a_disk_bytes=$(echo "$after_total" | awk '{print $6}')
        a_raw_bytes=$(echo "$after_total" | awk '{print $7}')
        a_uncomp_bytes=$(logical_game_bytes "$path")
        a_uncomp=$(bytes_human "$a_uncomp_bytes")

        u_mib=$((a_uncomp_bytes / 1048576))
        d_mib=$((a_disk_bytes / 1048576))
        saved_bytes=$((a_uncomp_bytes - a_disk_bytes))
        s_mib=$((saved_bytes / 1048576))
        saved_str=$(bytes_human "$saved_bytes")
        a_pct="$(awk -v u="$a_uncomp_bytes" -v d="$a_disk_bytes" 'BEGIN {
            if (u > 0) printf "%.1f%%", (u - d) * 100 / u;
            else print "0.0%"
        }')"
        record=1
    else
        local du_val
        du_val=$(du -sh --exclude=.bgc-assets-backup "$path" 2>/dev/null | awk '{print $1}')
        a_uncomp="${du_val:-Desc}"
        a_disk="${du_val:-Desc}"
        saved_str="n/a"
        a_pct="n/a"
        u_mib=0
        d_mib=0
        s_mib=0
    fi

    # Store logical file size as the stable original baseline, rather than
    # deriving it from the current compressed extents. This keeps later checks
    # from using a previous compression result as the game's original size.
    # If extent measurement fails, the zeroed trailing fields mark it unmeasured.
    # skips a record whose uncompressed size is 0, but the presence of the
    # record still stops the game being re-compressed on every single run.
    if [ "$record" -eq 1 ]; then
        state_upsert "$state_path" "$(printf '%s|%s|%s|%s|%s|%s|%s|%s|%s' \
            "$state_path" "$name" "$(date +%s)" "$a_uncomp" "$a_disk" "$saved_str" "$s_mib" "$u_mib" "$d_mib")"
    else
        state_upsert "$state_path" "$(printf '%s|%s|%s|%s|%s|%s|%s|%s|%s' \
            "$state_path" "$name" "$(date +%s)" "$a_uncomp" "$a_disk" "n/a" 0 0 0)"
    fi

    printf "%s\n" "$a_uncomp|$a_disk|$saved_str|$a_pct|$a_disk_bytes|$a_raw_bytes"
}

# Keep state writes behind a successful defragmentation result. Callers may
# capture the summary, but a failed btrfs command must never advance history.
compress_and_record() {
    local name="$1" path="$2" before_disk_bytes="${3:-}" before_raw_bytes="${4:-}" original_file_bytes="${5:-}" result
    compress_directory "$path" || return $?
    result=$(save_summary_record "$name" "$path") || return $?
    printf '%s|%s|%s|%s\n' "$result" "$before_disk_bytes" "$before_raw_bytes" "$original_file_bytes"
}

print_summary_block() {
    local name="$1" b_disk="$2" result="$3"
    local a_uncomp a_disk saved_str a_pct after_bytes raw_bytes before_bytes before_raw_bytes original_file_bytes
    IFS='|' read -r a_uncomp a_disk saved_str a_pct after_bytes raw_bytes before_bytes before_raw_bytes original_file_bytes <<< "$result"
    COMPRESS_ORIGINAL_BYTES="${original_file_bytes:-}"
    if ! [[ "$COMPRESS_ORIGINAL_BYTES" =~ ^[0-9]+$ ]]; then COMPRESS_ORIGINAL_BYTES="${before_bytes:-}"; fi
    COMPRESS_REPORT_PATH="${4:-}"
    COMPRESS_AFTER_BYTES="${after_bytes:-}"
    COMPRESS_ZSTD_SAVED_BYTES=0
    if [[ "$before_bytes" =~ ^[0-9]+$ ]] && [[ "$after_bytes" =~ ^[0-9]+$ ]] ; then
        COMPRESS_ZSTD_SAVED_BYTES=$((before_bytes - after_bytes))
    fi
    hrule
    printf "  %-20s %s\n" "Game:" "$name"
    if [[ "$original_file_bytes" =~ ^[0-9]+$ ]]; then
        printf "  %-20s %s\n" "Original file size:" "$(bytes_human "$original_file_bytes")"
    else
        printf "  %-20s %s\n" "Raw unique extents:" "$a_uncomp"
    fi
    printf "  %-20s %s\n" "Size Before:" "$b_disk"
    printf "  %-20s %s\n" "Size After (ZSTD):" "$a_disk"
    if [[ "$before_bytes" =~ ^[0-9]+$ ]] && [[ "$after_bytes" =~ ^[0-9]+$ ]] && [ "$before_bytes" -gt 0 ]; then
        local zstd_pct zstd_action zstd_color="$GREEN"
        zstd_pct=$(awk -v a="$before_bytes" -v b="$after_bytes" 'BEGIN {printf "%.1f%%", (a-b)*100/a}')
        zstd_action=saved
        if [ "$COMPRESS_ZSTD_SAVED_BYTES" -lt 0 ]; then zstd_action=increase; zstd_color="$YELLOW"; fi
        printf "  %-20s %b\n" "ZSTD change this pass:" "${zstd_color}$(bytes_human "$COMPRESS_ZSTD_SAVED_BYTES")${RESET} ($zstd_pct $zstd_action)"
    else
        printf "  %-20s %s\n" "ZSTD change this pass:" "unavailable (sudo measurement required)"
    fi
    hrule
}

# The state file records, per install path:
#   escaped-path|name|compressed-at|uncompressed|disk|saved|savedMiB|uncompMiB|diskMiB
# The trailing figures are only present once the game has actually been measured
# with compsize, so they are what lets us predict whether re-compressing after an
# update is worth the time. A leading '#' comment carries the format version.
#
# Older releases keyed records by game name only (8 fields with measurements,
# or 2 fields with just a timestamp). Those are captured into LEGACY_* rather
# than discarded, and matched to a path once the libraries are known, so an
# upgrade does not cost the user their whole compression history.
load_state() {
    STATE_MAP=()
    STATE_RATIO=()
    LEGACY_MAP=()
    LEGACY_RATIO=()
    LEGACY_REC=()
    local -a fields
    local key name ts u_mib d_mib state_line
    while IFS= read -r state_line; do
        case "$state_line" in
            '#'*|'') continue ;;
        esac
        IFS='|' read -r -a fields <<< "$state_line"
        if [ "${#fields[@]}" -ge 9 ]; then
            decode_field "${fields[0]}"
            key="$DECODED_FIELD"
            while [[ "$key" == */ && "$key" != "/" ]]; do key="${key%/}"; done
            ts="${fields[2]}"
            u_mib="${fields[7]}"; d_mib="${fields[8]}"
            [ -n "$key" ] || continue
            STATE_MAP["$key"]="$ts"
            if [ -n "${u_mib:-}" ] && [ "${u_mib:-0}" -gt 0 ] 2>/dev/null; then
                STATE_RATIO["$key"]=$(awk -v u="$u_mib" -v d="${d_mib:-0}" \
                    'BEGIN { printf "%.6f", (u - d) / u }')
            fi
            continue
        fi
        # Legacy name-keyed forms. The last line for a name wins, which mirrors
        # how the old state_upsert replaced by name.
        name="${fields[0]:-}"
        [ -n "$name" ] || continue
        ts="${fields[1]:-0}"
        LEGACY_MAP["$name"]="$ts"
        if [ "${#fields[@]}" -ge 8 ]; then
            # name|ts|uncomp|disk|saved|savedMiB|uncompMiB|diskMiB
            LEGACY_REC["$name"]="${fields[2]}|${fields[3]}|${fields[4]}|${fields[5]}|${fields[6]}|${fields[7]}"
            u_mib="${fields[6]:-0}"; d_mib="${fields[7]:-0}"
            if [ "${u_mib:-0}" -gt 0 ] 2>/dev/null; then
                LEGACY_RATIO["$name"]=$(awk -v u="$u_mib" -v d="${d_mib:-0}" \
                    'BEGIN { printf "%.6f", (u - d) / u }')
            fi
        fi
    done < "$STATE_FILE"
}

# After discovery, turn any legacy name-keyed record that is now matched to
# exactly one install path into a v2, path-keyed record, then drop the legacy
# lines. A name shared by several installs is deliberately left alone: there is
# no way to know which copy the old record described, and guessing would apply
# one game's history to another.
persist_legacy_migration() {
    [ "$#" -gt 0 ] || return 0
    local pair name path rec
    local -A name_count=() migrated=()
    for pair in "$@"; do
        name="${pair%%$'\t'*}"
        name_count["$name"]=$(( ${name_count["$name"]:-0} + 1 ))
    done
    for pair in "$@"; do
        name="${pair%%$'\t'*}"; path="${pair#*$'\t'}"
        [ -n "$name" ] && [ -n "$path" ] || continue
        [ "${name_count["$name"]:-0}" -eq 1 ] || continue
        rec="${LEGACY_REC["$name"]:-| |n/a|n/a|0|0|0}"
        state_upsert "$(encode_field "$path")" \
            "$(printf '%s|%s|%s|%s' "$(encode_field "$path")" "$name" "${LEGACY_MAP["$name"]:-0}" "$rec")"
        migrated["$name"]=1
    done
    [ "${#migrated[@]}" -gt 0 ] || return 0

    # Drop only the legacy lines that were actually migrated. A legacy name that
    # could not be matched with certainty (shared by several installs, or with
    # no matching directory at all) is kept, so a later run can still use it.
    local tmp="${STATE_FILE}.mig" drop_list=""
    for name in "${!migrated[@]}"; do
        drop_list="$drop_list$name"$'\n'
    done
    awk -F'|' -v drop="$drop_list" '
        BEGIN { n = split(drop, D, "\n"); for (i = 1; i <= n; i++) if (D[i] != "") skip[D[i]] = 1 }
        /^#/ { print; next }
        NF >= 9 { print; next }
        { if ($1 in skip) next; print }
    ' "$STATE_FILE" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
    backup_state
    mv -f "$tmp" "$STATE_FILE" 2>/dev/null
    rm -f "$tmp"
    return 0
}

discover_data() {
    VDF_FILES=(
        "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf"
        "$HOME/.local/share/Steam/config/libraryfolders.vdf"
        "$HOME/.steam/steam/steamapps/libraryfolders.vdf"
        "$HOME/.steam/steam/config/libraryfolders.vdf"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/libraryfolders.vdf"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/config/libraryfolders.vdf"
    )

    RAW_LIBS=()
    for vdf in "${VDF_FILES[@]}"; do
        if [ -f "$vdf" ]; then
        while IFS= read -r p; do
            [ -d "$p/steamapps/common" ] && RAW_LIBS+=("$p/steamapps/common")
        done < <(parse_vdf_libraries "$vdf")
        fi
    done

    [ -d "$HOME/.local/share/Steam/steamapps/common" ] && RAW_LIBS+=("$HOME/.local/share/Steam/steamapps/common")

    if [ -s "$CUSTOM_LIBS_FILE" ]; then
        while IFS= read -r c_path; do
            [ -d "$c_path" ] && RAW_LIBS+=("$c_path")
        done < "$CUSTOM_LIBS_FILE"
    fi

    declare -A seen_libs
    LIBS=()
    for lib in "${RAW_LIBS[@]}"; do
        [ -d "$lib" ] || continue
        [ -n "${seen_libs[$lib]}" ] && continue
        local fs_type
        fs_type=$(stat -f -c %T "$lib" 2>/dev/null || true)
        if [ "$fs_type" = "btrfs" ]; then
            LIBS+=("$lib")
            seen_libs["$lib"]=1
        fi
    done

    load_state
    load_dedupe_completions

    GAMES_NAME=()
    GAMES_PATH=()
    GAMES_STATUS=()
    GAMES_BYTES=()
    GAMES_SIZE=()
    GAMES_PREDICT=()
    # Per game, "pct|level" from the community table when this machine has not
    # measured it and the library's zstd level matches the row. Empty otherwise.
    # GAMES_HINT_LOW[i] is 1 when that hint is under min_gain_pct: an advisory
    # only, never a held-back game, because only a local pass can measure it.
    GAMES_HINT=()
    GAMES_HINT_LOW=()
    GAMES_DEDUPE_PENDING=()
    STAT_COMP_COUNT=0
    STAT_COMPRESSED_ONLY_COUNT=0
    STAT_UPD_COUNT=0
    STAT_UNCOMP_COUNT=0
    LOW_YIELD_COUNT=0
    STAT_RUNNING_COUNT=0
    SKIPPED_STUB_COUNT=0
    SKIPPED_STUB_NAMES=()
    MIGRATION_PAIRS=()
    local min_bytes=$(( MIN_SIZE_MIB * 1024 * 1024 ))

    # After LIBS is populated, and before the per-game loop below, which is the
    # first thing that needs the answer.
    discover_running_games

    for lib in "${LIBS[@]}"; do
        # The zstd level is a property of the filesystem, so it is resolved once
        # per library and the table is loaded for that level only. A level-1
        # mount must never be shown a level-6 measurement as if it applied.
        local lib_level
        lib_level=$(effective_level "$lib" 2>/dev/null || echo 3)
        load_ratios_hint "$lib_level"
        for dir in "$lib"/*/; do
            [ -d "$dir" ] || continue
            local name
            name=${dir%/*}; name=${name##*/}
            is_ignored "$name" && continue

            local game_path="${dir%/}"
            local comp_time="${STATE_MAP["$game_path"]:-}"
            local legacy_used=0
            # If this install has no path-keyed record yet, fall back to a
            # name-keyed record from an older release and plan to migrate it.
            # A name matches only when exactly one discovered install uses it,
            # so two copies of the same game never inherit each other's history.
            if [ -z "$comp_time" ] && [ -n "${LEGACY_MAP["$name"]:-}" ]; then
                comp_time="${LEGACY_MAP["$name"]}"
                legacy_used=1
            fi
            local dedupe_time g_bytes g_files g_newer g_human dedupe_newer dedupe_pending=0
            dedupe_time="${DEDUPE_MAP[$game_path]:-${DEDUPE_MAP[$lib]:-0}}"
            read -r g_bytes g_files g_newer g_human dedupe_newer <<< "$(scan_game_dir "$dir" "${comp_time:-0}" "$dedupe_time")"
            if [ -z "$dedupe_time" ] || [ "$((dedupe_time / 1000000000))" -lt "${comp_time:-0}" ] || [ "${dedupe_newer:-1}" -eq 1 ]; then
                dedupe_pending=1
            fi

            if [ "${g_bytes:-0}" -lt "$min_bytes" ]; then
                SKIPPED_STUB_COUNT=$(( SKIPPED_STUB_COUNT + 1 ))
                SKIPPED_STUB_NAMES+=("$name")
                continue
            fi

            GAMES_NAME+=("$name")
            GAMES_PATH+=("$game_path")
            GAMES_BYTES+=("${g_bytes:-0}")
            GAMES_SIZE+=("${g_human:-0B}")

            local st ratio="" predicted=0
            if [ -n "$comp_time" ]; then
                if [ "${g_newer:-0}" -eq 1 ]; then
                    st="UPDATED"
                elif [ "$dedupe_pending" -eq 1 ]; then
                    st="COMPRESSED"
                else
                    st="COMPACTED"
                fi
                if [ "$legacy_used" -eq 1 ]; then
                    ratio="${LEGACY_RATIO["$name"]:-}"
                    MIGRATION_PAIRS+=("$name"$'\t'"$game_path")
                else
                    ratio="${STATE_RATIO["$game_path"]:-}"
                fi
            else
                st="UNCOMPRESSED"
            fi

            # Cost-aware skip rule. Compressing is a *rewrite*: every byte of
            # the game is pushed back through zstd, so its cost - and the SSD
            # wear - scales with game size. The benefit is size * ratio, so the
            # only meaningful test is the ratio itself: a percentage, not a
            # fixed MiB number that would be huge for a 1 GB game and trivial
            # for a 40 GB one. Deleting data (see --slim) has no such cost, so
            # it is judged separately by a small absolute floor instead.
            #
            # Only games we have actually measured qualify here; a game with no
            # history has to be compressed once before anything is predictable.
            if [ -n "$ratio" ] && [[ "$st" != "COMPRESSED" && "$st" != "COMPACTED" ]]; then
                read -r predicted low <<< "$(awk \
                    -v b="${g_bytes:-0}" -v r="$ratio" \
                    -v mp="$MIN_GAIN_PCT" \
                    'BEGIN { p = b * r / 1048576; low = 0
                             if (mp > 0 && r * 100 < mp) low = 1
                             printf "%d %d", p, low }')"
                if [ "$low" -eq 1 ]; then
                    st="LOW YIELD"
                fi
            fi

            # Running wins over every other state: a game in play is not work
            # to be done later, it is work to not do at all, and the fix is to
            # close the game rather than to change a threshold.
            if [ -n "${RUNNING_DIRS["$game_path"]:-}" ]; then
                st="RUNNING"
            fi

            # Counted only once the final state is settled, so a game that is
            # both updated and running is not tallied under both.
            case "$st" in
                "COMPACTED")   STAT_COMP_COUNT=$((STAT_COMP_COUNT + 1)) ;;
                "COMPRESSED")  STAT_COMPRESSED_ONLY_COUNT=$((STAT_COMPRESSED_ONLY_COUNT + 1)) ;;
                "UPDATED")      STAT_UPD_COUNT=$((STAT_UPD_COUNT + 1)) ;;
                "UNCOMPRESSED") STAT_UNCOMP_COUNT=$((STAT_UNCOMP_COUNT + 1)) ;;
                "LOW YIELD")    LOW_YIELD_COUNT=$((LOW_YIELD_COUNT + 1)) ;;
                "RUNNING")      STAT_RUNNING_COUNT=$((STAT_RUNNING_COUNT + 1)) ;;
            esac

            # Community hint: display-only, and only for a game this machine has
            # not measured itself, at the library's own zstd level. It never
            # changes a game's state and never triggers a compression.
            local hint="" hint_low=0
            if [ -z "$ratio" ] && { [ "$st" = "UNCOMPRESSED" ] || [ "$st" = "UPDATED" ]; } \
                && [ -n "${HINT_RATIO["$name"]:-}" ]; then
                hint="${HINT_RATIO["$name"]}|$lib_level"
                hint_low="${HINT_LOW["$name"]:-0}"
            fi

            GAMES_STATUS+=("$st")
            GAMES_PREDICT+=("$predicted")
            GAMES_HINT+=("$hint")
            GAMES_HINT_LOW+=("$hint_low")
            GAMES_DEDUPE_PENDING+=("$dedupe_pending")

        done
    done

    # Persist any legacy history that matched a single install, so the migration
    # is a one-time cost and older records stop being candidates next run.
    if [ "${#MIGRATION_PAIRS[@]}" -gt 0 ]; then
        persist_legacy_migration "${MIGRATION_PAIRS[@]}"
    fi
}

show_statistics() {
    clear
    tput cnorm
    hrule
    echo "  COMPRESSION STATISTICS"
    hrule
    printf "${BOLD}%-36s %10s %10s %10s %8s${RESET}\n" "Game Name" "Original" "On Disk" "ZSTD Saved" "Saved %"
    hrule

    local totals
    totals=$(awk -F'|' -v BOLD="$BOLD" -v RESET="$RESET" '
        # LC_ALL=C is forced, so length() and substr() are byte-oriented and a
        # plain cut can land inside a multi-byte character. Keep at most n-1
        # bytes and step back until the next byte is not a UTF-8 continuation
        # byte (0x80-0xBF), so the result is always whole characters.
        function fit(s, n,   i, c) {
            if (length(s) <= n) return s
            i = n - 1
            while (i > 0) {
                c = substr(s, i + 1, 1)
                if (c < "\200" || c > "\277") break
                i--
            }
            return substr(s, 1, i) "…"
        }
        NF >= 9 && $1 != "" && $8 != "" && $9 != "" && $8 + 0 > 0 {
            pct = ($8 > 0) ? int(($7 * 100) / $8) : 0
            printf "%-36s %10s %10s %10s %7d%%\n", fit($2, 35), $4, $5, $6, pct
            total_uncomp += $8
            total_disk   += $9
            total_saved  += $7
            count++
        }
        END {
            print "###" total_uncomp "|" total_disk "|" total_saved "|" count
        }
    ' "$STATE_FILE")

    echo "$totals" | grep -v "^###"

    local summary_line
    summary_line=$(echo "$totals" | grep "^###")
    IFS='|' read -r total_uncomp total_disk total_saved count <<< "${summary_line#\#\#\#}"

    hrule
    if [ -z "$count" ] || [ "$count" -eq 0 ]; then
        echo "  No compressed games recorded yet."
    else
        local t_uncomp_str t_disk_str t_saved_str overall_pct=0
        if [ "$total_uncomp" -gt 0 ]; then overall_pct=$(( (total_saved * 100) / total_uncomp )); fi
        t_uncomp_str="$(awk -v m="$total_uncomp" 'BEGIN {printf "%.2f GB", m/1024}')"
        t_disk_str="$(awk -v m="$total_disk" 'BEGIN {printf "%.2f GB", m/1024}')"
        t_saved_str="$(awk -v m="$total_saved" 'BEGIN {printf "%.2f GB", m/1024}')"
        printf "  %-26s %s\n" "Total Games Compressed:" "$count"
        printf "  %-26s %s\n" "Total Original Size:" "$t_uncomp_str"
        printf "  %-26s %s\n" "Total Size on Disk:" "$t_disk_str"
        printf "  %-26s %b\n" "TOTAL ZSTD SAVED:" "${GREEN}${t_saved_str}${RESET} (${overall_pct}% overall reduction)"
    fi
    hrule
    echo -e "  ${DIM}Press any key to return to library...${RESET}"
    read_input
    tput civis
    NEEDS_FULL_CLEAR=1
}

manage_settings() {
    SETTINGS_LIBS_CHANGED=0
    while true; do
        clear
        tput civis
        local cur_mode
        cur_mode=$(cat "$THROTTLE_FILE" 2>/dev/null || echo "0")
        local mode_desc="${GREEN}Full Speed (Normal CPU & I/O priority)${RESET}"
        if [ "$cur_mode" = "1" ]; then mode_desc="${YELLOW}Eco Mode (Low CPU/IO priority via ionice/nice)${RESET}"; fi

        box_title "SETTINGS & PREFERENCES"
        echo -e "  Performance Mode: $mode_desc"
        echo "  ZSTD level: $COMPRESS_LEVEL (auto uses the filesystem setting)"
        local target_desc
        case "$VISUAL_TARGET" in
            ultra-performance) target_desc="${GREEN}Ultra Performance (480p)${RESET}" ;;
            performance) target_desc="${GREEN}Performance (720p)${RESET}" ;;
            balanced) target_desc="${GREEN}Balanced (1080p)${RESET}" ;;
            quality) target_desc="${GREEN}Quality (1440p)${RESET}" ;;
            ultra-quality) target_desc="${GREEN}Ultra Quality (4K)${RESET}" ;;
            lossless) target_desc="${GREEN}Lossless (Hades LZ4 packages only)${RESET}" ;;
            *) target_desc="${DIM}Native (no asset changes)${RESET}" ;;
        esac
        echo -e "  Asset profile: $target_desc"
        echo "  Applies to: loose images, DDS textures, PCM WAV, standalone FMOD, Hades packages, and"
        echo "              packed Godot PCK assets where supported."
        echo "  Texture safeguards: small (≤512 px) and thin textures are preserved;"
        echo "  known atlases are skipped. Resizing never leaves an edge below 64 px."
        echo "  Profile caps are soft: retain ≥half the original texture dimensions"
        echo "  and ≥7-bit RGB precision. Native is the byte-preserving default."
        echo "  No per-file restore copies are kept for packed assets; Steam's"
        echo "  'Verify integrity of game files' restores the originals."
        hrule
        echo "  Custom library paths:"
        if [ ! -s "$CUSTOM_LIBS_FILE" ]; then
            echo -e "  ${DIM}(none)${RESET}"
        else
            # -ba numbers empty lines too, so the printed index always matches the
            # line `sed "${n}d"` below removes. Without it, a blank line in the
            # file shifts every number and removal deletes the wrong library.
            nl -ba -w2 -s") " "$CUSTOM_LIBS_FILE"
        fi
        hrule
        echo "  [1] Toggle Speed / Throttle mode"
        echo "  [2] Add custom library path"
        echo "  [3] Remove custom library path"
        echo "  [4] Set ZSTD level (auto or 1-15)"
        echo "  [5] Choose [BETA] asset profile (images, DDS, WAV/FMOD, Hades packages)"
        echo "  [6] Languages to keep for --slim (removes other language packs)"
        if [ -n "$KEEP_LANGUAGES" ]; then
            echo "      currently keeping: $KEEP_LANGUAGES"
        else
            echo "      currently: (unset - language packs are never removed)"
        fi
        echo "  [7] Smallest saving worth a delete-only prune (MiB; compression uses the %, not this)"
        echo "      currently: $MIN_PRUNE_MIB MiB freeing"
        echo "  [b] Back to main menu"
        hrule
        box_footer "1-7: change a setting   b: back"

        local s_opt
        read_input
        s_opt="$KEY"
        case "$s_opt" in
            1)
                if [ "$cur_mode" = "0" ]; then echo "1" > "$THROTTLE_FILE"; else echo "0" > "$THROTTLE_FILE"; fi ;;
            2)
                tput cnorm
                echo ""
                read -r -p "Paste library path: " new_path
                tput civis
                new_path="${new_path/#\~/$HOME}"
                if [ -d "$new_path/steamapps/common" ]; then
                    new_path="$new_path/steamapps/common"
                fi
                if [ ! -d "$new_path" ]; then
                    echo -e "${RED}Error: Directory does not exist!${RESET}" ; sleep 1
                else
                    local fs_type
                    fs_type=$(stat -f -c %T "$new_path" 2>/dev/null || true)
                    if [ "$fs_type" != "btrfs" ]; then
                        echo -e "${YELLOW}Warning: Path is on $fs_type, NOT Btrfs.${RESET}" ; sleep 2
                    fi
                    echo "$new_path" >> "$CUSTOM_LIBS_FILE"
                    SETTINGS_LIBS_CHANGED=1
                fi ;;
            3)
                if [ -s "$CUSTOM_LIBS_FILE" ]; then
                    tput cnorm
                    echo ""
                    read -r -p "Enter number to remove: " rem_num
                    tput civis
                    # `sed '0d'` is an error, so 0 (and anything non-numeric) is
                    # ignored rather than allowed to fail silently.
                    if [[ "$rem_num" =~ ^[0-9]+$ ]] && [ "$rem_num" -ge 1 ]; then
                        sed -i "${rem_num}d" "$CUSTOM_LIBS_FILE"
                        SETTINGS_LIBS_CHANGED=1
                    fi
                fi ;;
            4)
                tput cnorm
                echo ""
                read -r -p "ZSTD level [auto or 1-15]: " new_level
                tput civis
                if [ "$new_level" = auto ] || { [[ "$new_level" =~ ^([1-9]|1[0-5])$ ]]; }; then
                    printf '%s\n' "$new_level" > "$LEVEL_FILE"
                    COMPRESS_LEVEL="$new_level"
                else
                    echo -e "${RED}Expected auto or a level from 1 to 15.${RESET}"
                    sleep 1
                fi ;;
            5)
                tput cnorm
                echo ""
                echo "  [BETA] Asset profiles change supported media files in place; originals are kept for restore."
                echo "  Lower profiles resize images/DDS, resample simple WAV, and lower supported FMOD Vorbis quality."
                echo "  Lossless only recompresses Hades v7 LZ4 packages; decoded assets stay identical."
                echo "  Anti-cheat compatibility is not detected. Native disables all asset changes."
                echo "  [1] Ultra Performance (480p)"
                echo "  [2] Performance (720p)"
                echo "  [3] Balanced (1080p)"
                echo "  [4] Quality (1440p)"
                echo "  [5] Ultra Quality (4K)"
                echo "  [6] Native (disable asset optimization)"
                echo "  [7] Lossless (Hades LZ4 packages only; no resizing/resampling)"
                echo "  [b] Back"
                echo -n "Choose profile [1-7/b]: "
                read_input
                target_choice="$KEY"
                case "$target_choice" in
                    1) VISUAL_TARGET=ultra-performance ;;
                    2) VISUAL_TARGET=performance ;;
                    3) VISUAL_TARGET=balanced ;;
                    4) VISUAL_TARGET=quality ;;
                    5) VISUAL_TARGET=ultra-quality ;;
                    6) VISUAL_TARGET=native ;;
                    7) VISUAL_TARGET=lossless ;;
                    b|B|q|Q|$'\x1b'|"") NEEDS_FULL_CLEAR=1; return ;;
                    *) echo -e "${RED}Choose a number from 1 to 7.${RESET}"; sleep 1; continue ;;
                esac
                printf '%s\n' "$VISUAL_TARGET" > "$VISUAL_TARGET_FILE" ;;
            6)
                tput cnorm
                echo ""
                echo "  Languages to keep, as codes or names separated by commas (e.g. en,de)."
                echo "  --slim removes every other language's data. Keep the language your game"
                echo "  defaults to, or startup can fail. Leave empty to disable language pruning."
                read -r -p "Keep languages: " new_langs
                tput civis
                KEEP_LANGUAGES=$(normalize_languages "$new_langs")
                printf '%s\n' "$KEEP_LANGUAGES" > "$KEEP_LANGUAGES_FILE"
                if [ -n "$KEEP_LANGUAGES" ]; then
                    echo "  Keeping: $KEEP_LANGUAGES"
                else
                    echo "  Language pruning disabled."
                fi
                sleep 1 ;;
            7)
                tput cnorm
                echo ""
                echo "  Deleting data is nearly free, so a small saving is still worth it."
                echo "  A prune whose total saving reaches this many MiB is offered. This does"
                echo "  NOT apply to compression, which is gated by the ratio (min_gain_pct)."
                read -r -p "Minimum prune saving [MiB]: " new_abs
                tput civis
                if [[ "$new_abs" =~ ^[0-9]+$ ]]; then
                    MIN_PRUNE_MIB="$new_abs"
                    printf '%s\n' "$new_abs" > "$DELETE_FILE"
                else
                    echo -e "${RED}Expected a whole number of MiB.${RESET}"
                    sleep 1
                fi ;;
            b|B|q|Q|$'\x1b'|"")
                NEEDS_FULL_CLEAR=1
                return ;;
            *)
                drain_pending_input ;;
        esac
    done
}

draw_progress_bar() {
    local current="$1" total="$2" width="${3:-40}"
    local filled empty pct
    if [ "$total" -le 0 ]; then total=1; fi
    pct=$(( (current * 100) / total ))
    filled=$(( (current * width) / total ))
    empty=$(( width - filled ))
    printf "  ["
    printf "%${filled}s" | tr ' ' '#'
    printf "%${empty}s" | tr ' ' '-'
    printf "] %3d%% (%d/%d)\n" "$pct" "$current" "$total"
}

batch_compress_routine() {
    clear
    tput cnorm
    local pending=0 all_mode=0 choice="" allow_assets=0
    local -a targets_idx=() skipped_low=()
    # Compression's only skip gate is the ratio (min_gain_pct), so LOW YIELD is
    # disabled exactly when that gate is off.
    local low_disabled
    low_disabled=$(awk -v p="$MIN_GAIN_PCT" \
        'BEGIN { print (p + 0 == 0) ? 1 : 0 }')
    for i in "${!GAMES_STATUS[@]}"; do
        case "${GAMES_STATUS[$i]}" in
            "UNCOMPRESSED"|"UPDATED") targets_idx+=("$i") ;;
            "COMPRESSED") targets_idx+=("$i") ;; # compressed already; dedupe only
            "LOW YIELD")
                if [ "${GAMES_DEDUPE_PENDING[$i]:-0}" -eq 1 ] || [ "$low_disabled" -eq 1 ]; then
                    targets_idx+=("$i")
                else
                    skipped_low+=("$i")
                fi
                ;;
        esac
    done
    pending=${#targets_idx[@]}

    # A finished filesystem compaction does not imply that optional visual
    # assets were processed. Recheck mode visits every installed game while
    # keeping filesystem compression limited to games that actually need it.
    if [ -t 0 ]; then
        echo "Batch mode:"
        echo "  [1] Process pending games (compress if needed, then optimize assets, then deduplicate)"
        echo "  [2] Optimize assets in every installed game ([BETA]; never recompresses whole games)"
        echo "      Processes supported media across each game folder; changed games are deduplicated."
        echo "  [c] Cancel"
        read -r -p "Choose [1/2/c]: " choice || choice=c
        case "$choice" in
            2) all_mode=1; targets_idx=(); skipped_low=() ;;
            1|"") ;;
            *) NEEDS_FULL_CLEAR=1; return ;;
        esac
    fi
    if [ "$all_mode" -eq 1 ]; then
        for i in "${!GAMES_STATUS[@]}"; do
            targets_idx+=("$i")
        done
        pending=${#targets_idx[@]}
    fi
    if [ "$all_mode" -eq 1 ] && [ "${VISUAL_TARGET:-native}" = native ]; then
        echo "Asset-only batch stopped: Native disables beta asset optimization. Choose a profile in Settings first."
        NEEDS_FULL_CLEAR=1
        return
    fi
    if [ "${VISUAL_TARGET:-native}" != native ] && [ "$pending" -gt 0 ] && [ -t 0 ]; then
        echo
        echo "[BETA] Asset profile: $VISUAL_TARGET"
        echo "Images/DDS may lose detail; WAV may be resampled and supported standalone FMOD may be re-encoded. Audio quality follows the asset profile, not Zstd level. Opus conversion is not attempted."
        echo "Anti-cheat is not detected automatically; modified online-game assets may be rejected. Originals are retained for restore."
        read -r -p "Apply beta asset optimization during this batch? [y/N] " choice || choice=n
        [[ "$choice" = y || "$choice" = Y ]] && allow_assets=1
    fi

    if [ "$pending" -eq 0 ]; then
        if [ "$all_mode" -eq 1 ]; then
            echo "No installed games were found to scan."
            NEEDS_FULL_CLEAR=1
            return
        fi
        if [ "${#skipped_low[@]}" -gt 0 ]; then
            echo -e "${YELLOW}Nothing to compress: ${#skipped_low[@]} game(s) are held back as low yield.${RESET}"
            echo "    Set min_gain_pct=0 to compress them anyway."
        else
            echo -e "${GREEN}All games are already compacted (compressed and deduplicated).${RESET}"
        fi
        if [ "$STAT_RUNNING_COUNT" -gt 0 ]; then
            echo -e "${YELLOW}$STAT_RUNNING_COUNT game(s) are running right now and were left alone.${RESET}"
            echo "    Close them and run this again to include them."
        fi
        sleep 1
        NEEDS_FULL_CLEAR=1
        return
    fi

    ensure_sudo
    BATCH_ASSET_DONE=0 BATCH_ASSET_NONE=0 BATCH_ASSET_FAILED=0 BATCH_ASSET_SCANNED=0
    BATCH_ASSET_PACKED=0 BATCH_ASSET_AUDIO=0
    BATCH_ASSET_IMAGES=0 BATCH_ASSET_TEXTURES=0 BATCH_ASSET_WAV=0 BATCH_ASSET_PACKAGES=0
    BATCH_ASSET_FILES=0 BATCH_ASSET_BYTES_BEFORE=0 BATCH_ASSET_BYTES_AFTER=0
    BATCH_ASSET_FOOTPRINT_SAVED=0 BATCH_ASSET_FOOTPRINT_MEASURED=0

    if [ "$all_mode" -eq 1 ]; then
        hrule
        echo "  BATCH ASSET OPTIMIZATION (Target games: $pending)"
        echo "  Whole-game compression is disabled; only games with changed assets are deduplicated."
    else
        hrule
        echo "  BATCH COMPACTION (Target games: $pending)"
    fi
    if [ "$STAT_RUNNING_COUNT" -gt 0 ]; then
        echo "  $STAT_RUNNING_COUNT running game(s) skipped - close them to include them."
    fi
    if [ "${#skipped_low[@]}" -gt 0 ]; then
        echo "  ${#skipped_low[@]} low-yield game(s) held back (compressing rewrites the whole game, so a low ratio is skipped; set min_gain_pct=0 to include them)."
    fi
    echo "  Press Ctrl+C anytime to cancel safely."
    hrule
    echo ""

    local done_count=0 skipped_running=0 failed_count=0 dedupe_failed=0 dedupe_rc asset_rc
    for idx in "${targets_idx[@]}"; do
        local g_name="${GAMES_NAME[$idx]}"
        local g_path="${GAMES_PATH[$idx]}"

        # Re-checked here rather than only at discovery time: a game can be
        # launched in the minutes between building the list and reaching it,
        # and defragmenting a running game is the one failure worth avoiding.
        # A /proc pass is milliseconds, against minutes of compression.
        discover_running_games
        if game_is_running "$g_path"; then
            echo -e "${YELLOW}  Skipping ${g_name}: it started running since the list was built.${RESET}"
            skipped_running=$(( skipped_running + 1 ))
            done_count=$((done_count + 1))
            continue
        fi

        local game_status="${GAMES_STATUS[$idx]}" needs_dedupe=0
        draw_progress_bar "$done_count" "$pending"
        BATCH_ASSET_CHANGED=0
        if [ "$all_mode" -eq 1 ]; then
            : # Explicit asset-only mode: never whole-game compress or baseline-dedupe.
        elif [ "$game_status" = "COMPACTED" ] || \
            { [ "$game_status" = "LOW YIELD" ] && [ "${GAMES_DEDUPE_PENDING[$idx]:-0}" -ne 1 ]; }; then
            : # The all-games mode is checking assets only for this game.
        elif [ "$game_status" = "COMPRESSED" ] || \
            { [ "$game_status" = "LOW YIELD" ] && [ "${GAMES_DEDUPE_PENDING[$idx]:-0}" -eq 1 ]; }; then
            needs_dedupe=1
        else
            echo -e "${BOLD}[$((done_count + 1))/$pending] Compressing: ${CYAN}$g_name${RESET}..."
            local b_raw b_disk result b_disk_bytes b_raw_bytes s_t e_t
            b_raw=$(run_compsize "$g_path" || true)
            b_disk=$(echo "$b_raw" | awk '/^TOTAL/ {print $3}')
            [ -n "$b_disk" ] || b_disk="N/A"
            b_disk_bytes=$(echo "$b_raw" | awk '/^TOTAL/ {print $6}')
            b_raw_bytes=$(echo "$b_raw" | awk '/^TOTAL/ {print $7}')
            s_t=$(date +%s)
            result=$(compress_and_record "$g_name" "$g_path" "$b_disk_bytes" "$b_raw_bytes" "$(logical_game_bytes "$g_path")"); dedupe_rc=$?
            case "$dedupe_rc" in 130|143) return "$dedupe_rc" ;; esac
            if [ "$dedupe_rc" -ne 0 ]; then
                echo -e "${RED}  Defragmentation failed for ${g_name}; leaving its saved state unchanged.${RESET}"
                failed_count=$(( failed_count + 1 ))
                done_count=$(( done_count + 1 ))
                continue
            fi
            e_t=$(( $(date +%s) - s_t ))
            print_summary_block "$g_name" "$b_disk" "$result" "$g_path"
            echo -e "    ${GREEN}✓ Finished in ${e_t}s${RESET}"
            needs_dedupe=1
            CHECKED_STATE[${GAMES_PATH[$idx]}]=0
        fi

        if [ "$allow_assets" -eq 1 ]; then
            printf '  Asset scan %d/%d: %s (%s)...\n' "$((done_count + 1))" "$pending" "$g_name" "$VISUAL_TARGET"
            batch_asset_game "$g_name" "$g_path"; asset_rc=$?
            case "$asset_rc" in
                130|143)
                    if [ "$BATCH_ASSET_CHANGED" -eq 1 ]; then
                        GAMES_STATUS[$idx]="COMPRESSED"
                        GAMES_DEDUPE_PENDING[$idx]=1
                    fi
                    return "$asset_rc" ;;
            esac
            [ "$BATCH_ASSET_CHANGED" -eq 1 ] && needs_dedupe=1
        fi

        # One final dedupe scan sees both the original game data and any
        # resized assets. This avoids the old two-scan-per-game batch path.
        if [ "$needs_dedupe" -eq 1 ]; then
            echo -e "${BOLD}  Deduplicating $g_name...${RESET}"
            run_dedupe_paths "DEDUPLICATION: $g_name" "$g_path"; dedupe_rc=$?
            case "$dedupe_rc" in 130|143) return "$dedupe_rc" ;; 0) ;; *) dedupe_failed=1 ;; esac
            if [ "$dedupe_rc" -eq 0 ] && [ "${DEDUPE_COMPLETION_RECORDED:-0}" -eq 1 ]; then
                GAMES_STATUS[$idx]="COMPACTED"
                GAMES_DEDUPE_PENDING[$idx]=0
            else
                GAMES_STATUS[$idx]="COMPRESSED"
                GAMES_DEDUPE_PENDING[$idx]=1
            fi
        fi
        done_count=$(( done_count + 1 ))
    done

    echo ""
    draw_progress_bar "$done_count" "$pending"
    if [ "$skipped_running" -gt 0 ]; then
        echo -e "${YELLOW}$skipped_running game(s) were skipped because they started running.${RESET}"
    fi
    echo ""
    if [ "${VISUAL_TARGET:-native}" = native ]; then
        echo "[BETA] Asset optimization: disabled (target is Native). Choose an asset profile in Settings to enable it."
    elif [ "$allow_assets" -eq 0 ]; then
        echo "[BETA] Asset optimization: not run (not selected or not confirmed)."
    else
        echo "[BETA] Asset results: scanned $BATCH_ASSET_SCANNED game(s) · changed assets in $BATCH_ASSET_DONE · no eligible assets $BATCH_ASSET_NONE · failed $BATCH_ASSET_FAILED."
        echo "  Changed files: images $BATCH_ASSET_IMAGES · textures (DDS or packed PCK) $BATCH_ASSET_TEXTURES · audio (WAV, standalone FMOD or packed PCK) $BATCH_ASSET_WAV · lossless Hades packages $BATCH_ASSET_PACKAGES."
        echo "  Logical sizes of changed files: $(bytes_human "$BATCH_ASSET_BYTES_BEFORE") → $(bytes_human "$BATCH_ASSET_BYTES_AFTER") · reduction: $(bytes_human "$((BATCH_ASSET_BYTES_BEFORE-BATCH_ASSET_BYTES_AFTER))") across $BATCH_ASSET_FILES file(s)."
        if [ "$BATCH_ASSET_FOOTPRINT_MEASURED" -gt 0 ]; then
            echo "  Live game data footprint after optimization: $(bytes_human "$BATCH_ASSET_FOOTPRINT_SAVED") lower in aggregate (restore data and snapshots can still occupy space)."
        else
            echo "  Physical game-data footprint change: unavailable; loose originals remain in restore copies (packed PCK keeps none), so logical reduction is not free space."
        fi
        echo "  Files identified: packed/media containers $BATCH_ASSET_PACKED · audio files $BATCH_ASSET_AUDIO (Hades v7 LZ4 and supported standalone FMOD are eligible; Bink and unknown formats stay unchanged)."
        echo "  WAV stays WAV. Converting to Opus needs explicit game/engine support and matching asset references; this tool does not rewrite those."
        echo "  Changed files keep their original path and container. Loose assets keep restore copies; packed PCK is rewritten in place, so recover it with Steam verify. Asset size reductions are not free-space savings until loose restore copies are finalized."
    fi
    if [ "$failed_count" -gt 0 ] || [ "$dedupe_failed" -eq 1 ] || [ "${BATCH_ASSET_FAILED:-0}" -gt 0 ]; then
        if [ "$all_mode" -eq 1 ]; then echo -e "${YELLOW}Asset batch finished with issue(s). Press any key to return...${RESET}"; else echo -e "${YELLOW}Batch finished with compression or deduplication issue(s). Press any key to return...${RESET}"; fi
    else
        if [ "$all_mode" -eq 1 ]; then echo -e "${GREEN}Asset optimization batch finished! Press any key to return...${RESET}"; else echo -e "${GREEN}Batch compression and deduplication finished! Press any key to return...${RESET}"; fi
    fi
    read_input
    tput civis
    NEEDS_FULL_CLEAR=1
}

join_stub_names() {
    local out="" n
    for n in "${SKIPPED_STUB_NAMES[@]}"; do
        if [ -z "$out" ]; then out="$n"; else out="$out, $n"; fi
    done
    printf '%s' "$out"
}

bytes_human() {
    awk -v b="${1:-0}" 'BEGIN {
        if (b < 0) { printf "-"; b = -b }
        if (b < 1024) { printf "%dB\n", b; exit }
        units = "KMGTPE"
        i = 0
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf "%.1f%c\n", b, substr(units, i, 1)
    }'
}

# Clamp a game name to a column budget, so one long name cannot wrap the box
# border. LC_ALL=C is forced, so ${#s} counts bytes rather than characters and a
# naive cut can land mid-character and leave a half glyph on screen. Step back
# to a character boundary instead: a byte is a boundary if it is not a
# UTF-8 continuation byte (0x80-0xBF).
#
# Sets NAME_FIT rather than echoing: a row is re-rendered on every keypress, and
# a command substitution would fork once per visible row per keystroke.
NAME_FIT=""
fit_name() {
    local s="$1" max="$2" i b
    if [ "${#s}" -le "$max" ]; then
        NAME_FIT="$s"
        return 0
    fi
    i=$(( max - 1 ))
    while [ "$i" -gt 0 ]; do
        printf -v b '%d' "'${s:i:1}"
        if [ "$b" -lt 128 ] || [ "$b" -gt 191 ]; then
            break
        fi
        i=$(( i - 1 ))
    done
    NAME_FIT="${s:0:i}…"
}

# A compact bar, e.g. "############....". Used by --status. Deliberately ASCII:
# LC_ALL=C is forced for number parsing, and locale-independent output is worth
# more here than a prettier glyph.
bar() {
    local current="$1" total="$2" width="${3:-28}" filled empty
    [ "$total" -le 0 ] && { printf '%*s' "$width" '' | tr ' ' '.'; return; }
    filled=$(( current * width / total ))
    [ "$filled" -gt "$width" ] && filled=$width
    empty=$(( width - filled ))
    printf '%*s' "$filled" '' | tr ' ' '#'
    printf '%*s' "$empty" '' | tr ' ' '.'
}

# Map a game state to a colour, so a wide report reads at a glance.
status_color() {
    case "$1" in
        COMPACTED)   printf '%s' "$GREEN" ;;
        COMPRESSED)  printf '%s' "$YELLOW" ;;
        UPDATED)      printf '%s' "$MAGENTA" ;;
        UNCOMPRESSED) printf '%s' "$YELLOW" ;;
        "LOW YIELD")  printf '%s' "$DIM" ;;
        RUNNING)      printf '%s' "$CYAN" ;;
        *)            printf '%s' "$RESET" ;;
    esac
}

cmd_status() {
    local i n_shown=0 n_total=0 n_pending=0 n_low=0 n_running=0

    if [ "${#LIBS[@]}" -gt 0 ]; then
        local doable=$(( ${#GAMES_NAME[@]} - STAT_COMP_COUNT - STAT_RUNNING_COUNT ))
        [ "$doable" -lt 0 ] && doable=0
        local pct=0
        [ "${#GAMES_NAME[@]}" -gt 0 ] && pct=$(( STAT_COMP_COUNT * 100 / ${#GAMES_NAME[@]} ))
        printf '%s\n' "================================================================================"
        printf '  %bBTRFS GAME COMPRESSOR%b %bv%s%b   %d game(s) across %d library(ies)\n' \
            "${BOLD}${CYAN}" "$RESET" "$DIM" "$VERSION" "$RESET" \
            "${#GAMES_NAME[@]}" "${#LIBS[@]}"
        printf '  [%s] %d%% compacted\n' \
            "$(bar "$STAT_COMP_COUNT" "${#GAMES_NAME[@]}")" "$pct"
        printf '%s\n' "================================================================================"
        printf '\n'
    fi

    printf '%b%-40s %-14s %10s %s%b\n' "$BOLD" "GAME" "STATUS" "SIZE" "EXPECTED GAIN" "$RESET"
    printf '%s\n' "--------------------------------------------------------------------------------"
    for i in "${!GAMES_NAME[@]}"; do
        local st="${GAMES_STATUS[$i]}"
        if [ "$OPT_PENDING_ONLY" -eq 1 ] && [[ "$st" == "COMPACTED" ]]; then
            continue
        fi
        n_total=$(( n_total + 1 ))
        local note=""
        case "$st" in
            "COMPRESSED")
                n_pending=$((n_pending + 1))
                note="dedupe pending"
                ;;
            "COMPACTED") n_shown=$((n_shown + 1)) ;;
            "UPDATED"|"UNCOMPRESSED")
                n_pending=$(( n_pending + 1 ))
                # A community hint is shown only when the library's zstd level
                # matches the row it came from, and it is labelled as a table
                # figure so it is never mistaken for a local measurement.
                if [ -n "${GAMES_HINT[$i]:-}" ]; then
                    note=$(printf ' table says ~%s%% (zstd%s)' \
                        "${GAMES_HINT[$i]%%|*}" "${GAMES_HINT[$i]##*|}")
                    if [ "${GAMES_HINT_LOW[$i]:-0}" -eq 1 ]; then
                        note="$note - likely low yield"
                    fi
                fi
                ;;
            "LOW YIELD")
                n_low=$(( n_low + 1 ))
                note=$(printf ' ~%s expected' "$(bytes_human "$(( ${GAMES_PREDICT[$i]:-0} * 1048576 ))")")
                [ "${GAMES_DEDUPE_PENDING[$i]:-0}" -eq 1 ] && note="$note · dedupe pending"
                ;;
            "RUNNING")
                n_running=$(( n_running + 1 ))
                note=" (close the game first)"
                ;;
        esac
        fit_name "${GAMES_NAME[$i]}" "$STATUS_NAME_WIDTH"
        printf '%-40s %b%-14s%b %10s %s\n' \
            "$NAME_FIT" "$(status_color "$st")" "$st" "$RESET" "${GAMES_SIZE[$i]}" "$note"
    done
    printf '%s\n' "--------------------------------------------------------------------------------"
    printf 'libraries: %d   games: %d   pending: %d   compacted: %d   compressed only: %d   low-yield: %d' \
        "${#LIBS[@]}" "$n_total" "$n_pending" "$n_shown" "$STAT_COMPRESSED_ONLY_COUNT" "$n_low"
    if [ "$n_running" -gt 0 ]; then
        printf '   running: %d' "$n_running"
    fi
    printf '\n'
    if [ "$n_pending" -eq 0 ] && [ "$n_low" -eq 0 ] && [ "$n_total" -gt 0 ] && [ "$n_running" -eq 0 ]; then
        printf '%bAll games compacted - nothing to do.%b\n' "$GREEN" "$RESET"
    fi
    if [ "$SKIPPED_STUB_COUNT" -gt 0 ]; then
        printf 'skipped:   %d empty install(s) under %d MiB (%s)\n' \
            "$SKIPPED_STUB_COUNT" "$MIN_SIZE_MIB" "$(join_stub_names)"
    fi
    local i lib
    for lib in "${LIBS[@]}"; do
        local mp mlev
        mp=$(findmnt -no TARGET --target "$lib" 2>/dev/null || true)
        mlev=$(mount_zstd_level "$lib" || true)
        printf 'zstd:      %s -> mount %s%s, defragment level %s%s\n' \
            "$lib" "${mp:-?}" "${mlev:+ (level $mlev)}" \
            "$(effective_level "$lib")" \
            "$(is_removable_media "$lib" && echo ', removable media')"
    done
    case "$PLATFORM" in
        steamos)  printf 'platform:  SteamOS%s\n' \
                       "$(grep -q '^VARIANT_ID="steamdeck"' /etc/os-release 2>/dev/null && echo ' (Steam Deck)')" ;;
        steamdeck) printf 'platform:  Steam Deck\n' ;;
        cachyos)  printf 'platform:  CachyOS\n' ;;
        bazzite)   printf 'platform:  Bazzite\n' ;;
        fedora)    printf 'platform:  Fedora\n' ;;
        arch)      printf 'platform:  Arch Linux\n' ;;
        ubuntu)    printf 'platform:  Ubuntu\n' ;;
        debian)    printf 'platform:  Debian\n' ;;
        opensuse)  printf 'platform:  openSUSE\n' ;;
        *)         printf 'platform:  %s\n' "$PLATFORM" ;;
    esac
    if [ "$COMPSIZE_OK" -ne 1 ]; then
        printf 'note: native backend not found - savings figures unavailable (run --status for structure only)\n'
    fi
    if [ "${#LIBS[@]}" -eq 0 ]; then
        printf 'note: no btrfs Steam libraries found. Add one with --library /path/to/library\n'
    fi
    return 0
}

cmd_status_json() {
    local i comma="" n_total=0 n_pending=0 n_compressed=0 n_compacted=0 n_low=0 n_running=0
    printf '{"version":%s,"libraries":[' "$(json_quote "$VERSION")"
    for i in "${!LIBS[@]}"; do
        [ "$i" -gt 0 ] && printf ','
        printf '%s' "$(json_quote "${LIBS[$i]}")"
    done
    printf '],"games":['
    for i in "${!GAMES_NAME[@]}"; do
        local st="${GAMES_STATUS[$i]}"
        if [ "$OPT_PENDING_ONLY" -eq 1 ] && [[ "$st" == "COMPACTED" ]]; then
            continue
        fi
        case "$st" in
            COMPACTED) n_compressed=$((n_compressed + 1)); n_compacted=$((n_compacted + 1)) ;;
            COMPRESSED) n_compressed=$((n_compressed + 1)); n_pending=$((n_pending + 1)) ;;
            UPDATED|UNCOMPRESSED) n_pending=$((n_pending + 1)) ;;
            "LOW YIELD") n_low=$((n_low + 1)) ;;
            RUNNING) n_running=$((n_running + 1)) ;;
        esac
        n_total=$((n_total + 1))
        printf '%s{"name":%s,"path":%s,"status":%s,"size_bytes":%s,"size_display":%s,"expected_gain_mib":%s' \
            "$comma" "$(json_quote "${GAMES_NAME[$i]}")" \
            "$(json_quote "${GAMES_PATH[$i]%/}")" "$(json_quote "$st")" \
            "${GAMES_BYTES[$i]:-0}" "$(json_quote "${GAMES_SIZE[$i]}")" \
            "${GAMES_PREDICT[$i]:-0}"
        if [ -n "${GAMES_HINT[$i]:-}" ]; then
            printf ',"community_hint_pct":%s,"community_hint_level":%s,"community_hint_low_yield":%s' \
                "${GAMES_HINT[$i]%%|*}" "$(json_quote "zstd${GAMES_HINT[$i]##*|}")" \
                "$([ "${GAMES_HINT_LOW[$i]:-0}" -eq 1 ] && printf true || printf false)"
        fi
        printf '}'
        comma=,
    done
    printf '],"summary":{"game_count":%d,"pending":%d,"compressed":%d,"compacted":%d,"compressed_only":%d,"low_yield":%d,"running":%d,"skipped_empty":%d}}\n' \
        "$n_total" "$n_pending" "$n_compressed" "$n_compacted" "$((n_compressed - n_compacted))" "$n_low" "$n_running" "$SKIPPED_STUB_COUNT"
}

cmd_notify() {
    local i count=0 names="" name entry extra=0
    local -a pending_names=()
    # The watch-only timer runs this twice a day, which makes it the natural
    # place to keep the tool itself current. It never touches a game.
    maybe_auto_update
    if ! command -v notify-send >/dev/null 2>&1; then
        echo "$PROGNAME: --notify requires the optional 'notify-send' command (libnotify)." >&2
        return 1
    fi
    for i in "${!GAMES_NAME[@]}"; do
        case "${GAMES_STATUS[$i]}" in
            COMPRESSED|UPDATED|UNCOMPRESSED)
                # A community hint rides along with the name so the notice says
                # what to expect, but only at the level the library actually uses.
                entry="${GAMES_NAME[$i]}"
                if [ -n "${GAMES_HINT[$i]:-}" ]; then
                    entry="$entry (~${GAMES_HINT[$i]%%|*}% at zstd${GAMES_HINT[$i]##*|})"
                fi
                pending_names+=("$entry")
                count=$((count + 1))
                ;;
            "LOW YIELD")
                if [ "${GAMES_DEDUPE_PENDING[$i]:-0}" -eq 1 ]; then
                    pending_names+=("${GAMES_NAME[$i]} (dedupe pending)")
                    count=$((count + 1))
                fi
                ;;
        esac
    done
    if [ "$count" -eq 0 ]; then
        printf 'No games need compression or deduplication.\n'
        return 0
    fi
    for name in "${pending_names[@]}"; do
        if [ "${#names}" -ge 180 ]; then
            extra=$((extra + 1))
            continue
        fi
        if [ -n "$names" ]; then names="$names, "; fi
        names="$names$name"
    done
    [ "$extra" -gt 0 ] && names="$names, and $extra more"
    notify-send "Btrfs Game Compressor" "$count game(s) need compression or deduplication: $names" \
        || { echo "$PROGNAME: desktop notification could not be delivered." >&2; return 1; }
    return 0
}

# Human-readable byte count from a MiB integer, matching the rest of the tool.
mib_human() {
    awk -v m="${1:-0}" 'BEGIN {
        if (m < 1024) { printf "%d MiB\n", m; exit }
        gb = m / 1024
        if (gb < 1024) { printf "%.2f GiB\n", gb; exit }
        printf "%.2f TiB\n", gb / 1024
    }'
}

# Percentage that $1 is of $2, to one decimal place.
pct_of() {
    awk -v s="${1:-0}" -v u="${2:-0}" \
        'BEGIN { if (u > 0) printf "%.1f", s * 100 / u; else printf "0.0" }'
}

# Seconds to add to a UTC epoch to get local time, from `date +%z` (e.g. +0200).
# Falls back to UTC if the value is not the expected shape.
tz_offset_seconds() {
    local tz sign hh mi
    tz=$(date +%z 2>/dev/null || true)
    case "$tz" in
        [+-][0-9][0-9][0-9][0-9]) ;;
        *) printf '0'; return 0 ;;
    esac
    sign=1
    [ "${tz:0:1}" = "-" ] && sign=-1
    hh=$((10#${tz:1:2}))
    mi=$((10#${tz:3:2}))
    printf '%d' "$(( sign * (hh * 3600 + mi * 60) ))"
}

# awk helpers shared by every reader of the state database.
#
# Deliberately POSIX awk only. asort() and strftime() are gawk extensions, and
# Debian/Ubuntu ship mawk as /usr/bin/awk by default, so relying on them makes
# --history and --benchmark die with "function asort never defined" on exactly
# the distros most people install from. Octal string escapes are avoided for the
# same reason. Instead:
#   - sorting emits a zero-padded key and pipes through sort(1), which also
#     orders numerically; asort() compares as strings, so "7.90" outranked "68.00"
#   - dates come from the epoch via the standard civil-from-days algorithm
#   - column clamping is done in bash by fit_name, already tested on multi-byte
STATE_AWK_FUNCS='
    function unescape(s) {
        gsub(/%0D/, "\r", s); gsub(/%0A/, "\n", s)
        gsub(/%7C/, "|", s); gsub(/%25/, "%", s)
        return s
    }
    function cleantab(s) { gsub(/\t/, " ", s); return s }
    function jesc(s,   out, i, c) {
        out = ""
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "\\") out = out "\\\\"
            else if (c == "\"") out = out "\\\""
            else out = out c
        }
        return out
    }
    function civildate(ts,   z, era, doe, yoe, y, doy, mp, d, m, sod, hh, mi) {
        z = int(ts / 86400) + 719468
        era = int((z >= 0 ? z : z - 146096) / 146097)
        doe = z - era * 146097
        yoe = int((doe - int(doe/1460) + int(doe/36524) - int(doe/146096)) / 365)
        y = yoe + era * 400
        doy = doe - (365*yoe + int(yoe/4) - int(yoe/100))
        mp = int((5*doy + 2)/153)
        d = doy - int((153*mp+2)/5) + 1
        m = mp + (mp < 10 ? 3 : -9)
        if (m <= 2) y++
        sod = ts - int(ts / 86400) * 86400
        if (sod < 0) sod += 86400
        hh = int(sod / 3600)
        mi = int((sod % 3600) / 60)
        return sprintf("%04d-%02d-%02d %02d:%02d", y, m, d, hh, mi)
    }
'

# Dedupe measurement ledger is separate from compression state. Its summary
# reports the latest pass per library rather than summing repeated operations.
dedupe_history_summary() {
    awk -F'|' '
        NF >= 9 && $1 ~ /^[0-9]+$/ && $2 != "" && $9 ~ /^-?[0-9]+$/ {
            passes++
            path = $2
            ts = $1 + 0
            if (!(path in newest) || ts >= newest[path]) {
                newest[path] = ts
                latest_saved[path] = $9 + 0
            }
            if (ts > newest_ts) newest_ts = ts
        }
        END {
            for (path in newest) { libraries++; saved += latest_saved[path] }
            printf "%d\t%d\t%d\t%d\n", passes + 0, libraries + 0, saved + 0, newest_ts + 0
        }
    ' "$DEDUPE_HISTORY_FILE" 2>/dev/null
}

dedupe_history_rows() {
    local tzoff="$1"
    awk -F'|' -v tzoff="$tzoff" "$STATE_AWK_FUNCS"'
        NF >= 9 && $1 ~ /^[0-9]+$/ && $2 != "" && $9 ~ /^-?[0-9]+$/ {
            ts = $1 + 0
            printf "%012d\t%s\t%s\t%s\t%s\t%s\n", ts, civildate(ts + tzoff), \
                cleantab(unescape($2)), $3, $6, $9
        }
    ' "$DEDUPE_HISTORY_FILE" 2>/dev/null | sort -r | cut -f2-
}

# Format one epoch second as local YYYY-MM-DD HH:MM without forking `date`.
epoch_local() {
    awk -v t="${1:-0}" -v o="$(tz_offset_seconds)" "$STATE_AWK_FUNCS"'
        BEGIN { print civildate(t + o) }'
}

# One summary pass over the state file. Emits a single tab-separated line:
#   rows  before_mib  after_mib  saved_mib  best_pct  best_name  over50  newest
state_summary() {
    awk -F'|' "$STATE_AWK_FUNCS"'
        NF >= 9 && $1 != "" && $8 != "" && $9 != "" {
            u = $8 + 0; d = $9 + 0
            if (u <= 0) next
            rows++; tu += u; td += d
            pct = (u - d) * 100 / u
            if (pct > best_pct) { best_pct = pct; best_name = cleantab(unescape($2)) }
            if (pct >= 50) over50++
            ts = $3 + 0
            if (ts > newest) newest = ts
        }
        END {
            printf "%d\t%d\t%d\t%d\t%.2f\t%s\t%d\t%d\n", \
                rows + 0, tu + 0, td + 0, (tu - td) + 0, best_pct + 0, \
                best_name, over50 + 0, newest + 0
        }
    ' "$STATE_FILE" 2>/dev/null
}

# History rows, newest first: when, name, raw, on-disk, saved.
history_rows() {
    awk -F'|' -v tzoff="$1" "$STATE_AWK_FUNCS"'
        NF >= 9 && $1 != "" && $8 != "" && $9 != "" && $8 + 0 > 0 {
            ts = $3 + 0
            printf "%012d\t%s\t%s\t%s\t%s\t%s\n", \
                ts, civildate(ts + tzoff), cleantab(unescape($2)), $4, $5, $6
        }
    ' "$STATE_FILE" 2>/dev/null | sort -r | cut -f2-
}

# Benchmark rows, best saving first: name, before_mib, after_mib, pct.
benchmark_rows() {
    awk -F'|' "$STATE_AWK_FUNCS"'
        NF >= 9 && $1 != "" && $8 != "" && $9 != "" {
            u = $8 + 0; d = $9 + 0
            if (u <= 0) next
            pct = (u - d) * 100 / u
            printf "%08.2f\t%s\t%d\t%d\t%.1f\n", \
                pct, cleantab(unescape($2)), u, d, pct
        }
    ' "$STATE_FILE" 2>/dev/null | sort -r | cut -f2-
}

cmd_history() {
    local rows dedupe_rows tzoff when name before after savedstr n=0 d=0 path before_excl after_excl new_shared
    tzoff=$(tz_offset_seconds)
    rows=$(history_rows "$tzoff")
    dedupe_rows=$(dedupe_history_rows "$tzoff")
    if [ -z "$rows" ] && [ -z "$dedupe_rows" ]; then
        printf 'No compression history yet. Run a compression pass to start recording.\n'
        return 0
    fi
    if [ -n "$rows" ]; then
        echo 'ZSTD COMPRESSION HISTORY'
        printf '%b%-44s  %-16s  %10s %14s  %10s%b\n' "$BOLD" \
            "GAME" "WHEN" "RAW" "ON DISK" "ZSTD SAVED" "$RESET"
        printf '%s\n' "------------------------------------------------------------------------------------------------"
        while IFS=$'\t' read -r when name before after savedstr; do
            [ -n "$name" ] || continue
            fit_name "$name" 44
            printf '%-44s  %-16s  %10s -> %-10s  %10s\n' \
                "$NAME_FIT" "$when" "$before" "$after" "$savedstr"
            n=$(( n + 1 ))
        done <<< "$rows"
        printf '%s\n' "------------------------------------------------------------------------------------------------"
        printf '%d compression record(s)\n\n' "$n"
    fi
    if [ -n "$dedupe_rows" ]; then
        echo 'DEDUPLICATION HISTORY (physical game data before → after)'
        printf '%b%-16s  %-40s  %14s  %14s  %14s%b\n' "$BOLD" \
            "WHEN" "LIBRARY" "BEFORE" "AFTER" "SAVED" "$RESET"
        printf '%s\n' "---------------------------------------------------------------------------------------------------------------"
        while IFS=$'\t' read -r when path before_excl after_excl new_shared; do
            [ -n "$path" ] || continue
            fit_name "$path" 40
            printf '%-16s  %-40s  %14s  %14s  %14s\n' \
                "$when" "$NAME_FIT" "$(bytes_human "$before_excl")" \
                "$(bytes_human "$after_excl")" "$(bytes_human "$new_shared")"
            d=$(( d + 1 ))
        done <<< "$dedupe_rows"
        printf '%s\n' "---------------------------------------------------------------------------------------------------------------"
        printf '%d deduplication measurement(s)\n' "$d"
    fi
    return 0
}

cmd_stats() {
    local line rows tu td saved best_pct best_name over50 newest overall
    line=$(state_summary)
    IFS=$'\t' read -r rows tu td saved best_pct best_name over50 newest <<< "$line"
    rows=${rows:-0}; tu=${tu:-0}; td=${td:-0}; saved=${saved:-0}
    overall=$(pct_of "$saved" "$tu")

    hrule
    echo -e "  ${BOLD}SAVINGS STATISTICS${RESET}"
    hrule
    if [ "$rows" -eq 0 ]; then
        echo "  No compressed games recorded yet."
        echo "  Run the interactive batch ('b') or compress a game to populate this."
    else
        printf "  %-40s %s\n" "Games compressed:" "$rows"
        printf "  %-40s %s\n" "Total original size:" "$(mib_human "$tu")"
        printf "  %-40s %s\n" "Total size on disk:" "$(mib_human "$td")"
        printf "  %-40s %b\n" "Total ZSTD saved:" \
            "${GREEN}$(mib_human "$saved")${RESET} (${BOLD}${overall}%${RESET} overall)"
        if [ "${newest:-0}" -gt 0 ]; then
            printf "  %-40s %s\n" "Most recent compression:" "$(epoch_local "$newest")"
        fi
    fi
    local dedupe_line dedupe_passes dedupe_libs dedupe_latest dedupe_newest dedupe_pct
    dedupe_line=$(dedupe_history_summary)
    IFS=$'\t' read -r dedupe_passes dedupe_libs dedupe_latest dedupe_newest <<< "$dedupe_line"
    dedupe_pct=$(awk -F'|' '
        NF >= 9 && $1 ~ /^[0-9]+$/ && $2 != "" && $3 ~ /^[0-9]+$/ && $7 ~ /^[0-9]+$/ && $9 ~ /^-?[0-9]+$/ {
            path = $2; ts = $1 + 0
            if (!(path in newest) || ts >= newest[path]) {
                newest[path] = ts; before[path] = $3 + 0; after[path] = $7 + 0; saved[path] = $9 + 0
            }
        }
        END {
            for (path in newest) {
                if (before[path] <= 0) continue
                pct = saved[path] * 100 / before[path]
                if (!found || pct > best) { best = pct; found = 1 }
            }
            if (found) printf "%.1f", best; else printf "0.0"
        }
    ' "$DEDUPE_HISTORY_FILE" 2>/dev/null)
    hrule
    echo '  SAVINGS BY CATEGORY (largest measured percentage first)'
    printf '  %-23s %14s %11s  %s\n' 'CATEGORY' 'SAVED' 'REDUCTION' 'MEASUREMENT'
    local -a stat_rows=()
    if [ "$rows" -gt 0 ]; then
        stat_rows+=("$(printf '%08.2f|%s|%s|%s|%s' "$overall" 'ZSTD compression' "$(mib_human "$saved")" "$overall" 'current recorded games vs original bytes')")
    fi
    if [ "${dedupe_passes:-0}" -gt 0 ]; then
        stat_rows+=("$(printf '%08.2f|%s|%s|%s|%s' "${dedupe_pct:-0.0}" 'Deduplication' "$(bytes_human "$dedupe_latest")" "${dedupe_pct:-0.0}" 'latest physical extent delta per directory')")
    else
        stat_rows+=("99999999|Deduplication|not measured|n/a|no successful physical measurement recorded")
    fi
    if [ "${#stat_rows[@]}" -gt 0 ]; then
        while IFS='|' read -r _ category amount pct description; do
            [ -n "$category" ] || continue
            if [ "$pct" = n/a ]; then
                printf '  %-23s %14s %10s  %s\n' "$category" "$amount" "$pct" "$description"
            else
                printf '  %-23s %14s %9s%%  %s\n' "$category" "$amount" "$pct" "$description"
            fi
        done < <(printf '%s\n' "${stat_rows[@]}" | sort -t '|' -k1,1nr)
    fi
    if [ "${dedupe_passes:-0}" -gt 0 ]; then
        printf '  Dedupe: %s successful pass(es), %s directory(s); latest pass %s.\n' "$dedupe_passes" "$dedupe_libs" "$(epoch_local "$dedupe_newest")"
    fi
    printf '  %-23s %14s %10s  %s\n' 'Language removal' 'not tracked' 'n/a' 'no durable before/after ledger yet'
    printf '  %-23s %14s %10s  %s\n' 'Asset optimization' 'not tracked' 'n/a' 'logical changes exist; net physical history not persisted'
    echo '  Percentages use each category’s own measured before-size. Dedupe scope can overlap game records; do not add rows into a grand total.'
    hrule
    return 0
}

cmd_export_fmod() {
    local result tag before after changed skipped status
    result=$(BGC_ASSET_PROGRESS=1 "$(native_backend)" fmod-reencode "$FMOD_QUALITY" "$FMOD_SOURCE" "$FMOD_OUTPUT") || return $?
    IFS='|' read -r tag before after changed skipped status <<< "$result"
    [ "$tag" = FMOD ] || { printf 'Invalid FMOD backend response.\n' >&2; return 1; }
    if [ "$status" = EXPORTED ]; then
        printf '[EXPERIMENTAL] FMOD export: %s\n' "$FMOD_OUTPUT"
        printf 'Re-encoded %s stream(s), retained %s; logical file size %s → %s (reduction %s).\n' \
            "$changed" "$skipped" "$(bytes_human "$before")" "$(bytes_human "$after")" "$(bytes_human "$((before-after))")"
        printf 'Source unchanged. Export is lossy and not enabled for automatic asset replacement. Verify audio, loops and event timing in-game before using it. This is not net disk savings.\n'
    else
