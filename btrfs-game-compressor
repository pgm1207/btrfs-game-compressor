    result=$("$(native_backend)" texture-compress-tree "$TEXTURE_TREE_DIM" "$TEXTURE_TREE_INPUT" "$TEXTURE_TREE_OUTPUT") || return $?
    summary=$(printf '%s\n' "$result" | grep '^TEXTURE_COMPRESS_TOTAL|' | tail -n 1)
    [ -n "$summary" ] || { printf 'Invalid texture tree backend response.\n' >&2; return 1; }
    IFS='|' read -r tag exported before after skipped failed <<< "$summary"
    printf '[EXPERIMENTAL] Exported DDS under %s → %s\n' "$TEXTURE_TREE_INPUT" "$TEXTURE_TREE_OUTPUT"
    printf '%s file(s): logical bytes %s → %s; skipped %s; failed %s.\n' \
        "$exported" "$(bytes_human "$before")" "$(bytes_human "$after")" "$skipped" "$failed"
    printf 'Source tree untouched; codec preserved; exported payloads are lossy and unverified in-game. This is export-only and not net disk savings.\n'
    [ "$failed" = 0 ]
}

# Container transforms are intentionally not part of automatic installed apply.
# Their write gate uses savings/output bytes, not total game size. Audit stays
# read-only; successful export retains the source and therefore is not net savings.
cmd_container() {
    local backend result status before after tag rest command
    backend=$(native_backend) || return $?
    if [ "$CONTAINER_ACTION" = audit ]; then
        printf 'Read-only packed-container audit; byte counts are logical, not physical savings.\n'
        "$backend" container-audit "$CONTAINER_SOURCE"
        return $?
    fi
    if [ "$CONTAINER_ACTION" = --audit-godot-textures ]; then
        printf 'Read-only PCK texture estimate for profile %s; nothing is written.\n' "$CONTAINER_PROFILE"
        result=$("$backend" godot-texture-audit "$CONTAINER_PROFILE" "$CONTAINER_SOURCE") || return $?
        IFS='|' read -r tag before after entries transformed skipped saved eff status <<< "$result"
        if [[ "$tag" != GODOT_TEXTURE ]]; then
            printf 'Invalid texture backend response.\n' >&2; return 1
        fi
        if [[ "$status" = NO_PROFILE ]]; then
            printf 'Native/Lossless makes no texture changes.\n'
            return 0
        fi
        printf 'PCK %s → %s: rewritable textures %s, unchanged %s, logical saving %s (%s%%).\n' \
            "$(bytes_human "$before")" "$(bytes_human "$after")" "$transformed" "$skipped" "$(bytes_human "$saved")" "$eff"
        printf 'Estimate only: no export written, no physical or in-game validation.\n'
        return 0
    fi
    if [ "$CONTAINER_ACTION" = --audit-godot3-audio ]; then
        printf 'Read-only Godot 3 packed-audio estimate for profile %s; nothing is written.\n' "$CONTAINER_PROFILE"
        result=$("$backend" godot3-audit "$CONTAINER_PROFILE" "$CONTAINER_SOURCE") || return $?
        IFS='|' read -r tag before after entries converted skipped wav_converted wav_skipped saved eff status <<< "$result"
        if [[ "$tag" != GODOT3 ]]; then
            printf 'Invalid Godot 3 audio backend response.\n' >&2; return 1
        fi
        if [[ "$status" = NO_PROFILE ]]; then
            printf 'Native/Lossless makes no audio changes.\n'
            return 0
        fi
        printf 'PCK %s → %s: re-encodable MP3 tracks %s, unchanged %s, logical saving %s (%s%%).\n' \
            "$(bytes_human "$before")" "$(bytes_human "$after")" "$converted" "$skipped" "$(bytes_human "$saved")" "$eff"
        printf 'PCM samples: %s reducible in sample rate/bit depth, %s unchanged.\n' "$wav_converted" "$wav_skipped"
        printf 'Estimate only: no export written, no physical or in-game validation.\n'
        return 0
    fi
    case "$CONTAINER_ACTION" in
        --export-unityfs) command=unityfs-recompress ;;
        --export-godot) command=godot-dedup-export ;;
        --export-godot-textures)
            result=$("$backend" godot-texture-export "$CONTAINER_PROFILE" "$MIN_GAIN_PCT" "$CONTAINER_SOURCE" "$CONTAINER_OUTPUT") || return $?
            IFS='|' read -r tag before after entries transformed skipped saved eff status <<< "$result"
            if [[ "$tag" != GODOT_TEXTURE ]]; then
                printf 'Invalid texture backend response.\n' >&2; return 1
            fi
            if [[ "$status" = NO_PROFILE ]]; then
                printf 'Native/Lossless makes no texture changes; nothing written.\n'
                return 0
            fi
            if [[ "$status" = EXPORTED ]]; then
                printf '[EXPERIMENTAL LOSSY] Texture export: %s\n' "$CONTAINER_OUTPUT"
                printf 'Logical file size %s → %s; rewrote %s textures (%s skipped). Source unchanged.\n' \
                    "$(bytes_human "$before")" "$(bytes_human "$after")" "$transformed" "$skipped"
                printf 'Lossy profile %s: unsupported textures were copied unchanged. In-game loading and physical savings still need validation.\n' "$CONTAINER_PROFILE"
                return 0
            fi
            printf 'No export written: %s (minimum gain/output-write efficiency %s%%). Source unchanged.\n' "$status" "$MIN_GAIN_PCT"
            return 0 ;;
        --export-godot3-audio)
            result=$("$backend" godot3-optimize "$CONTAINER_PROFILE" "$MIN_GAIN_PCT" "$CONTAINER_SOURCE" "$CONTAINER_OUTPUT") || return $?
            IFS='|' read -r tag before after entries converted skipped wav_converted wav_skipped saved eff status <<< "$result"
            if [[ "$tag" != GODOT3 ]]; then
                printf 'Invalid Godot 3 audio backend response.\n' >&2; return 1
            fi
            if [[ "$status" = NO_PROFILE ]]; then
                printf 'Native/Lossless makes no audio changes; nothing written.\n'
                return 0
            fi
            if [[ "$status" = EXPORTED ]]; then
                printf '[EXPERIMENTAL LOSSY] Godot 3 audio export: %s\n' "$CONTAINER_OUTPUT"
                printf 'Logical file size %s → %s; re-encoded %s MP3 tracks as Ogg Vorbis (%s skipped). Source unchanged.\n' \
                    "$(bytes_human "$before")" "$(bytes_human "$after")" "$converted" "$skipped"
                printf 'PCM samples: %s reduced in sample rate/bit depth, %s unchanged.\n' "$wav_converted" "$wav_skipped"
                printf 'Lossy profile %s: matching .import stubs were retyped. In-game playback/looping and physical savings still need validation.\n' "$CONTAINER_PROFILE"
                return 0
            fi
            printf 'No export written: %s (minimum gain/output-write efficiency %s%%). Source unchanged.\n' "$status" "$MIN_GAIN_PCT"
            return 0 ;;
        *) printf 'Unknown container action.\n' >&2; return 2 ;;
    esac
    result=$("$backend" "$command" "$MIN_GAIN_PCT" "$CONTAINER_SOURCE" "$CONTAINER_OUTPUT") || return $?
    IFS='|' read -r tag before after rest <<< "$result"
    status=${result##*|}
    if [[ "$tag" != UNITYFS && "$tag" != GODOT_DEDUP ]] || [[ ! "$before" =~ ^[0-9]+$ || ! "$after" =~ ^[0-9]+$ ]]; then
        printf 'Invalid container backend response.\n' >&2; return 1
    fi
    if [ "$status" = EXPORTED ]; then
        printf '[EXPERIMENTAL LOSSLESS] Container export: %s\n' "$CONTAINER_OUTPUT"
        printf 'Logical file size %s → %s. Source unchanged; game loading and physical savings still need validation.\n' \
            "$(bytes_human "$before")" "$(bytes_human "$after")"
    elif [[ "$status" = NO_GAIN || "$status" = LOW_EFFICIENCY ]]; then
        printf 'No export written: %s (minimum gain/output-write efficiency %s%%). Source unchanged.\n' "$status" "$MIN_GAIN_PCT"
    else
        printf 'Unknown container export status.\n' >&2; return 1
    fi
}

# A lossless logical reduction is not necessarily a physical reduction after
# the filesystem's own codec. Rollback is safe only for a fresh backup set.
lossless_guard_ready() {
    local game="$1" baseline="$2"
    if [ -e "$game/.bgc-assets-backup" ] || [ -L "$game/.bgc-assets-backup" ]; then
        printf 'Lossless physical guard: restore or finalize existing asset backups before a new pass.\n' >&2
        return 1
    fi
    if [[ ! "$baseline" =~ ^[0-9]+$ ]]; then
        printf 'Lossless physical guard: exact Btrfs measurement is required; game unchanged.\n' >&2
        return 1
    fi
}

# Return 0 for a smaller live footprint, 2 for a successful rollback, and 1
# if rollback failed. Never discard a pre-existing backup set (checked above).
lossless_guard_verify() {
    local game="$1" baseline="$2" measured selection relative original_bytes candidate_bytes
    LOSSLESS_GUARD_REJECTED=0 LOSSLESS_GUARD_BEFORE=0 LOSSLESS_GUARD_AFTER=0
    selection=$(mktemp) || return 1
    local selection_rc
    if [ "$(id -u)" -eq 0 ]; then
        "$(native_backend)" assets-physical-rejections "$game" >"$selection" 2>/dev/null; selection_rc=$?
    else
        sudo -n -- "$(native_backend)" assets-physical-rejections "$game" >"$selection" 2>/dev/null; selection_rc=$?
    fi
    if [ "$selection_rc" -eq 0 ]; then
        while IFS= read -r -d '' relative; do
            IFS= read -r -d '' original_bytes && IFS= read -r -d '' candidate_bytes || {
                rm -f "$selection"; return 1;
            }
            [[ "$original_bytes" =~ ^[0-9]+$ && "$candidate_bytes" =~ ^[0-9]+$ ]] || {
                rm -f "$selection"; return 1;
            }
            "$(native_backend)" assets-restore-file "$game" "$relative" >/dev/null || {
                rm -f "$selection"; return 1;
            }
            LOSSLESS_GUARD_REJECTED=$((LOSSLESS_GUARD_REJECTED+1))
            LOSSLESS_GUARD_BEFORE=$((LOSSLESS_GUARD_BEFORE+original_bytes))
            LOSSLESS_GUARD_AFTER=$((LOSSLESS_GUARD_AFTER+candidate_bytes))
        done < "$selection"
    fi
    rm -f "$selection"
    if [ "$LOSSLESS_GUARD_REJECTED" -gt 0 ]; then
        printf 'Lossless physical guard: restored %s package(s) that did not improve physical storage.\n' "$LOSSLESS_GUARD_REJECTED" >&2
    fi
    measured=$(asset_usage_bytes "$game") || measured=""
    if [[ "$measured" =~ ^[0-9]+$ ]] && [ "$measured" -lt "$baseline" ]; then
        return 0
    fi
    printf 'Lossless physical guard: live storage did not improve or measurement failed; restoring originals.\n' >&2
    "$(native_backend)" assets restore lossless 0 "$game" >/dev/null || {
        printf 'Automatic restore failed; originals remain available for --restore-assets.\n' >&2
        return 1
    }
    return 2
}

# Remove unused, non-gameplay files into the same restorable backup tree used
# by asset transforms, so --restore-assets and --finalize-assets already apply.
cmd_prune_assets() {
    local game="" matches=0 i
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$PRUNE_QUERY" = "${GAMES_PATH[$i]}" ] || [ "$PRUNE_QUERY" = "${GAMES_NAME[$i]}" ]; then
            game="${GAMES_PATH[$i]}"
            matches=$(( matches + 1 ))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$PRUNE_QUERY" >&2
        return 2
    fi
    require_btrfs
    local rels=() candidate
    if [ "$PRUNE_FALLBACKS" -eq 1 ]; then
        for candidate in "Content/Movies/720p" "Content/Win/Packages/720p" "Content/Win/Packages/BC3"; do
            [ -d "$game/$candidate" ] && rels+=("$candidate")
        done
        if [ "${#rels[@]}" -eq 0 ]; then
            printf 'No low-resolution or BC3 fallback suites found for %s.\n' "$game"
        fi
    fi
    discover_running_games
    if [ -n "${RUNNING_DIRS[$game]:-}" ]; then
        printf 'Close %s before pruning its files.\n' "$game" >&2
        return 1
    fi
    local plan count bytes
    plan=$("$(native_backend)" prune-plan "$game" --debug "${rels[@]}") || {
        printf 'Prune scan failed.\n' >&2; return 1
    }
    IFS='|' read -r tag _ count bytes <<< "$plan"
    [ "$tag" = PRUNE ] || { printf 'Invalid prune response from the native backend.\n' >&2; return 1; }
    if [ "${count:-0}" -eq 0 ]; then
        printf 'Nothing to prune: no debug symbols or requested fallback suites found. Game unchanged.\n'
        return 0
    fi
    if [ "$MIN_PRUNE_MIB" -gt 0 ] && [ "${bytes:-0}" -lt "$(( MIN_PRUNE_MIB * 1048576 ))" ]; then
        printf 'Nothing worth pruning: only %s is reclaimable, under the %s MiB prune floor. Game unchanged.\n' \
            "$(bytes_human "${bytes:-0}")" "$MIN_PRUNE_MIB"
        return 0
    fi
    if [ ! -t 0 ]; then
        printf '%s needs an interactive terminal to confirm pruning %s file(s).\n' "$PROGNAME" "$count" >&2
        return 2
    fi
    printf 'Prune candidates: %s unused file(s), %s of logical data.\n' "$count" "$(bytes_human "$bytes")"
    printf 'Debug symbols are compiled-out data the released game does not load. '
    if [ "$PRUNE_FALLBACKS" -eq 1 ]; then
        printf 'The 720p/BC3 suites are only loaded when the engine selects low-resolution assets (a weak GPU or that setting); removing them can break playback on such a system.\n'
    else
        printf 'Fallback suites are left untouched; add --prune-fallbacks to remove them too.\n'
    fi
    printf 'Originals stay in a local restore copy: free space returns only after you test the game and run --finalize-assets. Continue? [y/N] '
    local reply; read -r reply || reply=""
    [[ "$reply" = y || "$reply" = Y ]] || return 0
    ensure_sudo
    local before after result
    before=$(asset_usage_bytes "$game") || before=""
    result=$("$(native_backend)" prune-apply "$game" --debug "${rels[@]}") || {
        printf 'Pruning stopped. Some files may be missing; run --restore-assets to recover.\n' >&2
        return 1
    }
    IFS='|' read -r tag _ count bytes <<< "$result"
    [ "$tag" = PRUNE ] || { printf 'Invalid prune response from the native backend.\n' >&2; return 1; }
    after=$(asset_usage_bytes "$game") || after=""
    printf 'Pruned %s unused file(s): %s logical bytes; originals retained for restore.\n' "$count" "$(bytes_human "$bytes")"
    if [ -n "$before" ] && [ -n "$after" ]; then
        printf 'Live game data on disk (excludes restore copies): %s → %s · footprint reduction: %s.\n' \
            "$(bytes_human "$before")" "$(bytes_human "$after")" "$(bytes_human "$((before-after))")"
        printf 'Free space returns after --finalize-assets; snapshots may still retain the blocks.\n'
    fi
}

# Read-only engine/container report. Explains where a game's bytes live so the
# right optimization (prune, or a future format-aware pass) can be chosen.
cmd_engines() {
    local game="" matches=0 i
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$ENGINES_QUERY" = "${GAMES_PATH[$i]}" ] || [ "$ENGINES_QUERY" = "${GAMES_NAME[$i]}" ]; then
            game="${GAMES_PATH[$i]}"
            matches=$(( matches + 1 ))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$ENGINES_QUERY" >&2
        return 2
    fi
    local output
    output=$("$(native_backend)" engine-scan "$game") || {
        printf 'Engine scan failed.\n' >&2; return 1
    }
    printf 'Engine and containers for %s (read-only; nothing changed):\n' "$game"
    local line engines=0 tag class bytes files path
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            ENGINE\|*)
                engines=$(( engines + 1 ))
                IFS='|' read -r tag class path <<< "$line"
                printf '  engine: %s (%s)\n' "$class" "$path" ;;
        esac
    done <<< "$output"
    if [ "$engines" -eq 0 ]; then
        printf '  engine: not recognized\n'
    fi
    printf '  largest containers:\n'
    while IFS='|' read -r tag class bytes files path; do
        [ "$tag" = CONTAINER ] || continue
        printf '    %10s  %-15s %6s files  %s\n' "$(bytes_human "${bytes:-0}")" "$class" "${files:-0}" "${path:-.}"
    done < <(printf '%s\n' "$output" | awk -F'|' '$1=="CONTAINER"{print $3"|"$0}' | sort -rn | cut -d'|' -f2-)
    printf '  Nothing was changed. Inspect candidates with --variants or supported packed files with --audit-container. Supported packed PCK textures/audio are rewritten only by asset apply, not by this audit.\n'
}

# One-shot, format-agnostic slimming: keep the highest resolution tier and the
# host-platform build, remove the rest plus debug symbols, all restorable.
cmd_slim() {
    local game="" matches=0 i
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$SLIM_QUERY" = "${GAMES_PATH[$i]}" ] || [ "$SLIM_QUERY" = "${GAMES_NAME[$i]}" ]; then
            game="${GAMES_PATH[$i]}"
            matches=$(( matches + 1 ))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$SLIM_QUERY" >&2
        return 2
    fi
    require_btrfs
    discover_running_games
    if [ -n "${RUNNING_DIRS[$game]:-}" ]; then
        printf 'Close %s before slimming it.\n' "$game" >&2
        return 1
    fi
    local -a rels=()
    local slims total=0 count=0 line bytes path
    slims=$("$(native_backend)" variants-slim "$game" "$KEEP_LANGUAGES") || {
        printf 'Slim scan failed.\n' >&2; return 1
    }
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ "${line#SLIM|}" != "$line" ] || continue
        bytes="${line#SLIM|}"; bytes="${bytes%%|*}"
        path="${line##*|}"
        [[ "$bytes" =~ ^[0-9]+$ && -n "$path" ]] || continue
        rels+=("$path")
        total=$(( total + bytes ))
        count=$(( count + 1 ))
    done <<< "$slims"
    local debug_plan dbgcount=0 dbgbytes=0
    debug_plan=$("$(native_backend)" prune-plan "$game" --debug) || true
    IFS='|' read -r _ _ dbgcount dbgbytes <<< "$debug_plan"
    dbgcount=${dbgcount:-0}; dbgbytes=${dbgbytes:-0}
    local grand=$(( total + dbgbytes )) grandcount=$(( count + dbgcount ))
    if [ "$grandcount" -eq 0 ]; then
        printf 'Nothing to slim in %s: no unused fallback suites or debug symbols found. Game unchanged.\n' "$game"
        printf 'Use --variants for a full report, including language and architecture suites you may want to prune manually.\n'
        return 0
    fi
    # Deleting is cheap, so pruning is judged by a small absolute floor rather
    # than by a ratio: a low percentage is fine when nothing has to be rewritten.
    if [ "$MIN_PRUNE_MIB" -gt 0 ] && [ "$grand" -lt "$(( MIN_PRUNE_MIB * 1048576 ))" ]; then
        printf 'Nothing worth pruning in %s: only %s is reclaimable, under the %s MiB prune floor. Game unchanged.\n' \
            "$game" "$(bytes_human "$grand")" "$MIN_PRUNE_MIB"
        return 0
    fi
    printf 'Slim plan for %s:\n' "$game"
    if [ "$count" -gt 0 ]; then
        printf '  unused fallback suites (%s, %s):\n' "$count" "$(bytes_human "$total")"
        for path in "${rels[@]}"; do printf '    %s\n' "$path"; done
    fi
    printf '  developer debug symbols: %s file(s), %s\n' "$dbgcount" "$(bytes_human "$dbgbytes")"
    if [ -n "$KEEP_LANGUAGES" ]; then
        printf '  languages kept: %s (all other language packs removed)\n' "$KEEP_LANGUAGES"
    else
        printf '  languages: none selected - language packs are left untouched (set with --keep-languages en,de or in Settings)\n'
    fi
    printf '  total logical: %s\n' "$(bytes_human "$grand")"
    printf 'Kept: the highest resolution tier, the host-platform build, your languages and every non-variant file. Removing fallbacks is only visible if the engine selects a lower tier or another platform.\n'
    if [ -n "$KEEP_LANGUAGES" ]; then
        printf 'Warning: keep the language the game starts with (usually the first/English one); removing it can prevent startup. If in doubt, test and use --restore-assets.\n'
    fi
    if [ ! -t 0 ]; then
        printf '%s needs an interactive terminal to confirm slimming %s item(s).\n' "$PROGNAME" "$grandcount" >&2
        return 2
    fi
    printf 'Originals stay in a local restore copy: free space returns only after you test the game and run --finalize-assets. Continue? [y/N] '
    local reply; read -r reply || reply=""
    [[ "$reply" = y || "$reply" = Y ]] || return 0
    ensure_sudo
    local before after result
    before=$(asset_usage_bytes "$game") || before=""
    result=$("$(native_backend)" prune-apply "$game" --debug ${rels[@]+"${rels[@]}"}) || {
        printf 'Slimming stopped. Some files may be missing; run --restore-assets to recover.\n' >&2
        return 1
    }
    IFS='|' read -r _ _ count bytes <<< "$result"
    after=$(asset_usage_bytes "$game") || after=""
    printf 'Slimmed %s unused file(s): %s logical bytes; originals retained for restore.\n' "$count" "$(bytes_human "${bytes:-0}")"
    steam_update_advisory
    if [ -n "$before" ] && [ -n "$after" ]; then
        printf 'Live game data on disk (excludes restore copies): %s → %s · footprint reduction: %s.\n' \
            "$(bytes_human "$before")" "$(bytes_human "$after")" "$(bytes_human "$((before-after))")"
        printf 'Free space returns after --finalize-assets; snapshots may still retain the blocks.\n'
    fi
}

# Read-only, format-agnostic report of sibling suites that share a file-name
# layout (architecture builds, renderer/shader suites, resolution tiers,
# language packs). Nothing is measured with privilege and nothing changes.
cmd_variants() {
    local game="" matches=0 i
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$VARIANT_QUERY" = "${GAMES_PATH[$i]}" ] || [ "$VARIANT_QUERY" = "${GAMES_NAME[$i]}" ]; then
            game="${GAMES_PATH[$i]}"
            matches=$(( matches + 1 ))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$VARIANT_QUERY" >&2
        return 2
    fi
    local output
    output=$("$(native_backend)" variants-scan "$game") || {
        printf 'Variant scan failed.\n' >&2; return 1
    }
    if [ -z "$output" ]; then
        printf 'No redundant asset variants detected for %s.\n' "$game"
        printf 'Sibling directories sharing an identical file-name set but different data (architecture, renderer, resolution or language suites) are reported here. Nothing was changed.\n'
        return 0
    fi
    printf 'Redundant asset variants in %s (read-only; nothing changed):\n' "$game"
    local total=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        local -a f=(); IFS='|' read -r -a f <<< "$line"
        local n=$(( (${#f[@]}-1)/4 )) best=0 sum=0 j
        for (( j=0; j<n; j++ )); do
            local b="${f[$((1+j*4))]}"
            [[ "$b" =~ ^[0-9]+$ ]] || continue
            sum=$(( sum + b ))
            (( b > best )) && best=$b
        done
        local potential=$(( sum - best ))
        total=$(( total + potential ))
        printf '\n  Potential to reclaim: %s (keep the largest member)\n' "$(bytes_human "$potential")"
        for (( j=0; j<n; j++ )); do
            local b="${f[$((1+j*4))]}" files="${f[$((2+j*4))]}" flag="${f[$((3+j*4))]}" path="${f[$((4+j*4))]}"
            local mark=""
            [ "$flag" = 1 ] && mark=" [variant-like name]"
            printf '    %10s  %6s files  %s%s\n' "$(bytes_human "$b")" "$files" "${path:-.}" "$mark"
        done
    done <<< "$output"
    printf '\nTotal potentially reclaimable: %s (logical). Confirm which member the engine actually loads before removing a suite; reuse --prune-assets/--restore-assets for a reversible change.\n' "$(bytes_human "$total")"
}

asset_usage_bytes() {
    local line
    if [ "$EUID" -eq 0 ]; then
        line=$("$(native_backend)" measure-bytes "$1" 2>/dev/null) || return 1
    else
        line=$(sudo -n -- "$(native_backend)" measure-bytes "$1" 2>/dev/null) || return 1
    fi
    printf '%s\n' "${line%%|*}"
}

# Inform users; never claim to have changed Steam settings or disabled patches.
steam_update_advisory() {
    printf 'Steam update tip: for optimized games, set Properties > Updates > Automatic Updates > Only update this game when I launch it. This defers background updates but does not disable launch-required patches. Revalidate modified assets after any update.\n'
}

asset_scan_summary() {
    local packed="${1:-0}" audio="${2:-0}" raster="${3:-0}" total="${4:-0}" packed_bytes="${5:-0}" audio_bytes="${6:-0}"
    printf 'Asset inventory: loose images %s · packed/textures/video %s · audio files %s.\n' "$raster" "$packed" "$audio"
    if [ "$total" -gt 0 ]; then
        printf 'Scanned logical data: %s · packed/textures/video: %s · audio: %s (not disk-space savings).\n' \
            "$(bytes_human "$total")" "$(bytes_human "$packed_bytes")" "$(bytes_human "$audio_bytes")"
    fi
    printf 'Hades v7 LZ4 packages can be recompressed losslessly; other archives/XNB, Bink/video and encoded audio are not converted.\n'
}

asset_workflow() {
    local query="$1" requested="$2" confirmed="${3:-0}" target="$VISUAL_TARGET" game="" matches=0 i
    local action=plan result tag reported_target count before after retained packed audio images textures wavs raster total packed_bytes audio_bytes packages disk_before="" disk_after="" level=0
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$query" = "${GAMES_PATH[$i]}" ] || [ "$query" = "${GAMES_NAME[$i]}" ]; then
            game="${GAMES_PATH[$i]}"
            matches=$(( matches + 1 ))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$query" >&2
        return 2
    fi
    case "$requested" in
        --apply-assets) action=apply ;;
        --restore-assets) action=restore; target=native ;;
        --finalize-assets) action=finalize; target=native ;;
    esac
    require_btrfs
    if [ "$action" != plan ]; then
        discover_running_games
        if [ -n "${RUNNING_DIRS[$game]:-}" ]; then
            printf 'Close %s before changing its assets.\n' "$query" >&2
            return 1
        fi
        if [ "$action" = apply ]; then
            result=$("$(native_backend)" assets plan "$target" 0 "$game") || return 1
            IFS='|' read -r tag _ reported_target count before after _ packed audio images textures wavs raster total packed_bytes audio_bytes packages <<< "${result##*$'\n'}"
            [ "$tag" = ASSETS ] || return 1
            ASSET_PREVIEW_COUNT="$count"
            if [ "$count" -eq 0 ]; then
                printf '[BETA] No supported asset files can be reduced for this profile. No files changed. Bink, embedded FMOD and unsupported package formats are not rewritten.\n'
                asset_scan_summary "$packed" "$audio" "$raster" "$total" "$packed_bytes" "$audio_bytes"
                return 0
            fi
            printf '[BETA] Asset profile: %s · images %s, textures %s, audio %s, lossless Hades packages %s · estimated logical sizes: %s → %s (reduction %s)\n' \
                "$reported_target" "${images:-0}" "${textures:-0}" "${wavs:-0}" "${packages:-0}" "$(bytes_human "$before")" "$(bytes_human "$after")" \
                "$(bytes_human "$((before-after))")"
            if [ "$confirmed" != 1 ] && [ ! -t 0 ]; then
                printf '%s needs an interactive terminal to confirm asset changes.\n' "$requested" >&2
                return 2
            fi
            if [ "$confirmed" != 1 ]; then
                printf '[BETA] Images/DDS may lose detail; WAV may be resampled and standalone FMOD re-encoded. Anti-cheat is not detected automatically. Loose assets keep a restore copy; supported packed PCK files have no restore copy (recover with Steam "Verify integrity of game files"). Apply to %s? [y/N] ' "$query"
            fi
        elif [ "$action" = finalize ]; then
            if [ ! -t 0 ]; then
                printf '%s needs an interactive terminal to confirm asset changes.\n' "$requested" >&2
                return 2
            fi
            printf 'Discard the local restore copy for %s? Steam verification may be needed to recover originals. [y/N] ' "$query"
        fi
        if [ "$action" = apply ] || [ "$action" = finalize ]; then
            local reply
            read -r reply || reply=""
            [[ "$reply" = y || "$reply" = Y ]] || return 0
        fi
        ensure_sudo
        disk_before=$(asset_usage_bytes "$game") || disk_before=""
        if [ "$action" = apply ]; then level=$(effective_level "$game"); fi
        if [ "$action" = apply ] && [ "$target" = lossless ]; then
            lossless_guard_ready "$game" "$disk_before" || return 1
        fi
    fi
    result=$("$(native_backend)" assets "$action" "$target" "$level" "$game") || {
        printf 'Asset action stopped. Some files may have changed; use --restore-assets after checking the error.\n' >&2
        return 1
    }
    # Packed transforms may emit per-pack reports; ASSETS is the final summary.
    IFS='|' read -r tag action reported_target count before after retained packed audio images textures wavs raster total packed_bytes audio_bytes packages <<< "${result##*$'\n'}"
    [ "$tag" = ASSETS ] || { printf 'Invalid response from native asset backend.\n' >&2; return 1; }
    if [ "$action" = apply ] && [ "$target" = lossless ] && [ "$count" -gt 0 ]; then
        local guard_rc
        lossless_guard_verify "$game" "$disk_before"; guard_rc=$?
        case "$guard_rc" in
            1) return 1 ;;
            0) count=$((count-LOSSLESS_GUARD_REJECTED)); packages=$((packages-LOSSLESS_GUARD_REJECTED))
               before=$((before-LOSSLESS_GUARD_BEFORE)); after=$((after-LOSSLESS_GUARD_AFTER))
               retained=$((retained-LOSSLESS_GUARD_BEFORE)) ;;
            2) count=0; before=0; after=0; retained=0; packages=0
               printf 'Lossless candidates rejected: original game assets restored; no package savings accepted.\n' ;;
        esac
    fi
    printf '[BETA] Game: %s · Asset profile: %s · images %s, textures %s, audio %s, lossless Hades packages %s\n' "$query" "$reported_target" "${images:-0}" "${textures:-0}" "${wavs:-0}" "${packages:-0}"
    case "$action" in
        plan)
            ASSET_PREVIEW_COUNT="$count"
            asset_scan_summary "$packed" "$audio" "$raster" "$total" "$packed_bytes" "$audio_bytes"
            if [ "$count" -eq 0 ]; then
                printf 'No supported assets can be reduced for this profile. Game files are unchanged.\n'
            else
                printf 'Candidate asset bytes: %s → %s · possible logical reduction: %s\n' \
                    "$(bytes_human "$before")" "$(bytes_human "$after")" "$(bytes_human "$((before-after))")"
                printf 'Loose images/DDS are resized; WAV may be resampled and standalone FMOD re-encoded; supported packed PCK audio/textures have no restore copy. Hades v7 LZ4 packages are recompressed without changing decoded assets. Bink, embedded FMOD and unknown packages remain unchanged. These are logical sizes, not net disk savings.\n'
            fi ;;
        apply|restore|finalize)
            disk_after=$(asset_usage_bytes "$game") || disk_after=""
            if [ -n "$disk_before" ] && [ -n "$disk_after" ]; then
                printf 'Live game data on disk (excludes restore copies): %s → %s · footprint reduction: %s\n' \
                    "$(bytes_human "$disk_before")" "$(bytes_human "$disk_after")" "$(bytes_human "$((disk_before-disk_after))")"
            else
                printf 'Physical game measurement unavailable.\n'
            fi
            if [ "$action" = apply ]; then
                printf 'Changed %s asset file(s): logical bytes %s → %s · reduction %s (not net disk savings).\n' \
                    "$count" "$(bytes_human "$before")" "$(bytes_human "$after")" "$(bytes_human "$((before-after))")"
                printf 'Restore copy retained: %s of original asset data. Free space is not reclaimed until that copy is finalized; snapshots may also retain data.\n' "$(bytes_human "$retained")"
                if [ "$count" -gt 0 ]; then steam_update_advisory; fi
            elif [ "$action" = finalize ]; then
                printf 'Discarded restore copy: %s logical bytes. Snapshots or other references may retain the blocks.\n' "$(bytes_human "$retained")"
            fi ;;
    esac
}

# Fast read-only format/extension inventory, unlike --assets which runs bounded
# decoders to estimate actual transform candidates and may take much longer.
asset_inventory_report() {
    local query="$1" game="" matches=0 i output tag files bytes raster packed packed_bytes audio audio_bytes
    for i in "${!GAMES_PATH[@]}"; do
        if [ "$query" = "${GAMES_PATH[$i]}" ] || [ "${query,,}" = "${GAMES_NAME[$i],,}" ]; then
            game="${GAMES_PATH[$i]}"; matches=$((matches+1))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$query" >&2
        return 2
    fi
    output=$("$(native_backend)" asset-inventory "$game") || return $?
    IFS='|' read -r tag files bytes raster packed packed_bytes audio audio_bytes <<< "$output"
    [ "$tag" = ASSET_INVENTORY ] || { printf 'Invalid inventory response.\n' >&2; return 1; }
    printf 'Read-only inventory for %s (not a savings estimate):\n' "$query"
    printf '  Files: %s · logical bytes: %s\n' "$files" "$(bytes_human "$bytes")"
    printf '  Loose raster files: %s\n' "$raster"
    printf '  Packed/media-looking files: %s · %s\n' "$packed" "$(bytes_human "$packed_bytes")"
    printf '  Audio-looking files: %s · %s\n' "$audio" "$(bytes_human "$audio_bytes")"
    printf 'Inventory is extension-based only; --assets runs bounded format-aware decoders to estimate candidates. Unsupported containers stay untouched.\n'
}

asset_container_report() {
    local query="$1" game="" matches=0 i output wanted
    wanted=$(basename -- "$query")
    for i in "${!GAMES_PATH[@]}"; do
        if is_ignored "${GAMES_NAME[$i]}"; then continue; fi
        local install_base=${GAMES_PATH[$i]##*/}
        install_base=${install_base//[^[:alnum:]]/}
        wanted=${wanted//[^[:alnum:]]/}
        if [ "$query" = "${GAMES_PATH[$i]}" ] || [ "${query,,}" = "${GAMES_NAME[$i],,}" ] || [ "${wanted,,}" = "${GAMES_NAME[$i]//[^[:alnum:]]/}" ] || [ "${wanted,,}" = "${install_base,,}" ]; then
            game="${GAMES_PATH[$i]}"; matches=$((matches+1))
        fi
    done
    if [ "$matches" -ne 1 ]; then
        printf '%s: expected one installed game, found %d for %s\n' "$PROGNAME" "$matches" "$query" >&2
        return 2
    fi
    output=$("$(native_backend)" asset-container-inventory "$game") || return $?
    printf 'Standalone writer-supported format candidates in %s (inventory only):\n' "$query"
    if [ -z "$output" ]; then
        printf '  None detected.\n'
    else
        printf '%s\n' "$output" | while IFS='|' read -r tag class count bytes example; do
            [ "$tag" = ASSET_CONTAINER ] || continue
            printf '  %-12s %s file(s), %s · example: %s\n' "$class" "$count" "$(bytes_human "$bytes")" "$example"
        done
    fi
    printf 'Detection does not establish transform eligibility; unsupported inputs remain untouched.\n'
}

