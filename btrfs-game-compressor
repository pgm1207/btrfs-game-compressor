RESET="\e[0m"

# --- OpenCode-style framing -------------------------------------------------
# A dim box-drawing rule, an accent title bar and a dim key-hint footer, kept
# dependency-free. COLUMNS is consulted so a narrow terminal still looks sane.
BOX_H="─"

terminal_width() {
    local w="${COLUMNS:-}"
    if ! [[ "$w" =~ ^[0-9]+$ ]] || [ "$w" -lt 40 ]; then
        w=$(tput cols 2>/dev/null || echo 80)
    fi
    [[ "$w" =~ ^[0-9]+$ ]] || w=80
    # Leave the rightmost column free; writing into it makes terminals wrap.
    [ "$w" -gt 100 ] && w=100
    printf '%s' "$w"
}

# One full-width horizontal rule, e.g. ────────
hrule() {
    local w; w=$(terminal_width)
    local n=$(( w - 4 ))
    local line="" i
    for (( i = 0; i < n; i++ )); do line+="$BOX_H"; done
    printf '%s\n' "  $line"
}

# box_title "Main menu" [accent-colour]
box_title() {
    local title="$1" colour="${2:-$CYAN}"
    local w; w=$(terminal_width)
    local inner=$(( w - 4 ))
    local pad=$(( inner - ${#title} - 2 ))
    [ "$pad" -lt 1 ] && pad=1
    local rule="" i
    for (( i = 0; i < pad; i++ )); do rule+="$BOX_H"; done
    printf '%b\n' "  ${colour}${title}${RESET} ${DIM}${rule}${RESET}"
}

# A dim, full-width footer carrying the key hints, like a status bar.
box_footer() {
    local hint="$1"
    printf '%b\n' "  ${DIM}${hint}${RESET}"
}

