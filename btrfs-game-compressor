CURRENT_PAGE=1
PAGE_SIZE=15
FILTER_QUERY=""
VIEW_PENDING_ONLY=0
CURSOR_POS=0
NEEDS_FULL_CLEAR=1
COMPSIZE_OK=-1
declare -A CHECKED_STATE
declare -A STATE_MAP
declare -A STATE_RATIO
# Legacy, name-keyed records recovered from older state files. These MUST be
# declared associative: a plain `ARR=()` is an indexed array, and bash then
# evaluates a string subscript as an arithmetic expression, so
# `LEGACY_REC["$name"]` silently collapses every game into index 0 and the last
# record wins for all of them.
declare -A LEGACY_MAP
declare -A LEGACY_RATIO
declare -A LEGACY_REC
# Community table values, keyed by game name, for games this machine has not
# measured. Display-only; never decides whether something is compressed.
# HINT_LOW[name] is 1 when the hinted saving is under min_gain_pct, so a first
# pass through a game the table already knows is a poor investment can be advised
# against without ever blocking it (a local measurement still has to be made).
declare -A HINT_RATIO
