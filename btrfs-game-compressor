require_btrfs

# Look for a newer release now and then, before the UI takes over the screen.
# Throttled to once a day, silent, and a no-op for a package-managed install.
maybe_auto_update

# --- Main Program Loop ---
TUI_ACTIVE=1
while true; do
    tput civis
    if [ "$NEEDS_FULL_CLEAR" -eq 1 ]; then
        clear
        NEEDS_FULL_CLEAR=0
    else
        tput cup 0 0
    fi

    FILTERED_INDICES=()
    for i in "${!GAMES_NAME[@]}"; do
        name="${GAMES_NAME[$i]}"
        st="${GAMES_STATUS[$i]}"

        if [ "$VIEW_PENDING_ONLY" -eq 1 ] && [[ "$st" == "COMPACTED" ]]; then
            continue
        fi

        if [ -n "$FILTER_QUERY" ]; then
            l_name="${name,,}"
            l_query="${FILTER_QUERY,,}"
            if [[ "$l_name" != *"$l_query"* ]]; then
                continue
            fi
        fi

        FILTERED_INDICES+=("$i")
    done

    TOTAL_MATCHES=${#FILTERED_INDICES[@]}
    TOTAL_PAGES=$(( (TOTAL_MATCHES + PAGE_SIZE - 1) / PAGE_SIZE ))
    [ "$TOTAL_PAGES" -eq 0 ] && TOTAL_PAGES=1
    [ "$CURRENT_PAGE" -gt "$TOTAL_PAGES" ] && CURRENT_PAGE=$TOTAL_PAGES
    [ "$CURRENT_PAGE" -lt 1 ] && CURRENT_PAGE=1

    START_IDX=$(( (CURRENT_PAGE - 1) * PAGE_SIZE ))
    END_IDX=$(( START_IDX + PAGE_SIZE ))
    [ "$END_IDX" -gt "$TOTAL_MATCHES" ] && END_IDX=$TOTAL_MATCHES
    ITEMS_ON_PAGE=$(( END_IDX - START_IDX ))

    if [ "$CURSOR_POS" -ge "$ITEMS_ON_PAGE" ]; then
        if [ "$ITEMS_ON_PAGE" -gt 0 ]; then
            CURSOR_POS=$(( ITEMS_ON_PAGE - 1 ))
        else
            CURSOR_POS=0
        fi
    fi
    [ "$CURSOR_POS" -lt 0 ] && CURSOR_POS=0

    CHECKED_COUNT=0
    for val in "${CHECKED_STATE[@]}"; do
        if [[ "$val" == "1" ]]; then CHECKED_COUNT=$(( CHECKED_COUNT + 1 )); fi
    done

    # Header. This is top-level code, not a function, so `local` here would print
    # "can only be used in a function" on every redraw and write into the TUI.
    tui_pct=0
    [ "${#GAMES_NAME[@]}" -gt 0 ] && tui_pct=$(( STAT_COMP_COUNT * 100 / ${#GAMES_NAME[@]} ))
    box_title "BTRFS GAME COMPRESSOR  ·  v$VERSION"
    echo -e "  ${DIM}${#GAMES_NAME[@]} game(s) · ${#LIBS[@]} library(ies)${RESET}"
    printf "  [%s] %d%% compacted\n" "$(bar "$STAT_COMP_COUNT" "${#GAMES_NAME[@]}")" "$tui_pct"
    printf "  ${GREEN}%d Compacted${RESET}  │  ${YELLOW}%d Compressed only${RESET}  │  ${MAGENTA}%d Updated${RESET}  │  ${YELLOW}%d Uncompressed${RESET}" \
        "$STAT_COMP_COUNT" "$STAT_COMPRESSED_ONLY_COUNT" "$STAT_UPD_COUNT" "$STAT_UNCOMP_COUNT"
    if [ "$STAT_RUNNING_COUNT" -gt 0 ]; then
        printf "  │  ${CYAN}%d Running${RESET}" "$STAT_RUNNING_COUNT"
    fi
    # Only shown when non-zero, but then always shown, so the figures here add
    # up to the total. Labelled "Uncompressed" rather than "Pending", because
    # --status uses "pending" for the work still to do, which includes Updated.
    if [ "$LOW_YIELD_COUNT" -gt 0 ]; then
        printf "  │  ${RED}%d Low Yield${RESET}" "$LOW_YIELD_COUNT"
    fi
    printf "\n"
    hrule

    if [ "$VIEW_PENDING_ONLY" -eq 1 ] || [ -n "$FILTER_QUERY" ]; then
        printf "  ${CYAN}Filter active:${RESET} "
        [ "$VIEW_PENDING_ONLY" -eq 1 ] && printf "[PENDING ONLY] "
        [ -n "$FILTER_QUERY" ] && printf "[\"%s\"] " "$FILTER_QUERY"
        printf "(%d matches)\n" "$TOTAL_MATCHES"
        hrule
    fi

    # Items table
    printf "${BOLD}  SEL    ID   STATUS          GAME NAME${RESET}\n"
    hrule

    if [ "$TOTAL_MATCHES" -eq 0 ]; then
        echo "  (No games found matching your current filter)"
        for ((p = 1; p < PAGE_SIZE; p++)); do echo ""; done
    else
        for ((p = 0; p < PAGE_SIZE; p++)); do
            if [ "$p" -ge "$ITEMS_ON_PAGE" ]; then
                echo ""
                continue
            fi
            r_idx="${FILTERED_INDICES[$(( START_IDX + p ))]}"
            g_name="${GAMES_NAME[$r_idx]}"
            g_st="${GAMES_STATUS[$r_idx]}"

            case "$g_st" in
                "COMPACTED")   tag="${GREEN}[COMPACTED]   ${RESET}" ;;
                "COMPRESSED")  tag="${YELLOW}[COMPRESSED]  ${RESET}" ;;
                "UPDATED")      tag="${MAGENTA}[UPDATED]     ${RESET}" ;;
                "UNCOMPRESSED") tag="${YELLOW}[UNCOMPRESSED]${RESET}" ;;
                "LOW YIELD")    tag="${DIM}[LOW YIELD]   ${RESET}" ;;
                "RUNNING")      tag="${CYAN}[RUNNING]     ${RESET}" ;;
            esac

            if [[ "${CHECKED_STATE[${GAMES_PATH[$r_idx]}]:-0}" == "1" ]]; then
                chk="${CYAN}[x]${RESET}"
            else
                chk="[ ]"
            fi

            if [ "$p" -eq "$CURSOR_POS" ]; then
                ptr="${CYAN}>${RESET}"
                row_style="${BOLD}"
            else
                ptr=" "
                row_style=""
            fi

            # Clamped, so one very long game name cannot push the right-hand
            # border off the screen and wrap the whole layout.
            fit_name "$g_name" "$TUI_NAME_WIDTH"
            printf " %b %b  %3d   %b  %b%s${RESET}\033[K\n" \
                "$ptr" "$chk" "$((r_idx + 1))" "$tag" "$row_style" "$NAME_FIT"
        done
    fi

    hrule
    action_txt="Process highlighted"
    if [ "$CHECKED_COUNT" -gt 0 ]; then
        action_txt="${CYAN}Process $CHECKED_COUNT selected${RESET}"
    fi

    echo -e "  Page ${BOLD}${CURRENT_PAGE}/${TOTAL_PAGES}${RESET}  │  ${BOLD}↑/↓${RESET}: Move  │  ${BOLD}←/→${RESET}: Page  │  ${BOLD}Space${RESET}: Select  │  ${BOLD}Enter/c${RESET}: $action_txt\033[K"
    echo -e "  Actions: [${BOLD}b${RESET}] Batch menu (pending work or asset scan all)  [${BOLD}o${RESET}] Preview/apply assets for highlighted game\033[K"
    box_footer "↑/↓ move   ←/→ page   Space select   Enter process   b batch   o assets   s settings   q quit"

    if ! read_input; then
        clear
        tput cnorm
        echo "Input stream closed. Exiting."
        exit 0
    fi
    choice="$KEY"

    case "$choice" in
        q|Q) clear ; tput cnorm ; echo "Exiting." ; exit 0 ;;
        $'\x1b[A'|$'\x1bOA'|k|K) # UP
            if [ "$CURSOR_POS" -gt 0 ]; then
                CURSOR_POS=$(( CURSOR_POS - 1 ))
            fi
            continue ;;
        $'\x1b[B'|$'\x1bOB'|j|J) # DOWN
            if [ "$CURSOR_POS" -lt $(( ITEMS_ON_PAGE - 1 )) ]; then
                CURSOR_POS=$(( CURSOR_POS + 1 ))
            fi
            continue ;;
        # RIGHT ARROW (next page)
        $'\x1b[C'|$'\x1bOC'|n|N|$'\x1b[6~'|l|L)
            [ "$CURRENT_PAGE" -lt "$TOTAL_PAGES" ] && CURRENT_PAGE=$((CURRENT_PAGE + 1))
            CURSOR_POS=0
            continue ;;
        # LEFT ARROW (previous page)
        $'\x1b[D'|$'\x1bOD'|p|P|$'\x1b[5~'|h|H)
            [ "$CURRENT_PAGE" -gt 1 ] && CURRENT_PAGE=$((CURRENT_PAGE - 1))
            CURSOR_POS=0
            continue ;;
        " ") # Space: Toggle checkbox
            if [ "$ITEMS_ON_PAGE" -gt 0 ]; then
                cur_path="${GAMES_PATH[${FILTERED_INDICES[$(( START_IDX + CURSOR_POS ))]}]}"
                if [[ "${CHECKED_STATE[$cur_path]:-0}" == "1" ]]; then
                    CHECKED_STATE[$cur_path]=0
                else
                    CHECKED_STATE[$cur_path]=1
                fi
            fi
            continue ;;
        a|A) # Toggle all on current page
            all_checked=1
            for ((p = 0; p < ITEMS_ON_PAGE; p++)); do
                r_idx="${FILTERED_INDICES[$(( START_IDX + p ))]}"
                if [[ "${CHECKED_STATE[${GAMES_PATH[$r_idx]}]:-0}" != "1" ]]; then
                    all_checked=0
                    break
                fi
            done
            for ((p = 0; p < ITEMS_ON_PAGE; p++)); do
                r_idx="${FILTERED_INDICES[$(( START_IDX + p ))]}"
                r_path="${GAMES_PATH[$r_idx]}"
                if [ "$all_checked" -eq 1 ]; then
                    CHECKED_STATE[$r_path]=0
                else
                    CHECKED_STATE[$r_path]=1
                fi
            done
            continue ;;
        f|F|/)
            tput cnorm
            echo ""
            read -r -p "Search filter (press enter empty to reset): " FILTER_QUERY
            CURRENT_PAGE=1
            CURSOR_POS=0
            NEEDS_FULL_CLEAR=1
            continue ;;
        v|V)
            if [ "$VIEW_PENDING_ONLY" -eq 0 ]; then VIEW_PENDING_ONLY=1; else VIEW_PENDING_ONLY=0; fi
            CURRENT_PAGE=1
            CURSOR_POS=0
            continue ;;
        t|T)
            show_statistics
            continue ;;
        s|S)
            manage_settings
            if [ "${SETTINGS_LIBS_CHANGED:-0}" -eq 1 ]; then discover_data; fi
            continue ;;
        b|B)
            batch_compress_routine
            discover_data
            continue ;;
        o|O)
            if [ "$ITEMS_ON_PAGE" -gt 0 ]; then
                cur_path="${GAMES_PATH[${FILTERED_INDICES[$(( START_IDX + CURSOR_POS ))]}]}"
                clear
                tput cnorm
                ASSET_PREVIEW_COUNT=0
                asset_workflow "$cur_path" --assets
                if [ "$VISUAL_TARGET" != native ] && [ "${ASSET_PREVIEW_COUNT:-0}" -gt 0 ]; then
                    read -r -p "[BETA] Apply this profile to supported images, textures, audio and packed PCK? Loose files keep a restore copy; packed PCK is rewritten in place with no restore copy (recover via Steam verify); anti-cheat is not detected. [y/N] " asset_reply || asset_reply=""
                    if [[ "$asset_reply" = y || "$asset_reply" = Y ]]; then
                        asset_workflow "$cur_path" --apply-assets 1
                        discover_data
                    fi
                fi
                printf 'Press any key to return...'
                read_input
                tput civis
                NEEDS_FULL_CLEAR=1
            fi
            continue ;;
        c|C|"$KEY_ENTER")
            TARGETS=()
            for t_path in "${!CHECKED_STATE[@]}"; do
                if [[ "${CHECKED_STATE[$t_path]}" == "1" ]]; then
                    TARGETS+=("$t_path")
                fi
            done

            if [ ${#TARGETS[@]} -eq 0 ] && [ "$ITEMS_ON_PAGE" -gt 0 ]; then
                TARGETS+=("${GAMES_PATH[${FILTERED_INDICES[$(( START_IDX + CURSOR_POS ))]}]}")
            fi

            if [ ${#TARGETS[@]} -eq 0 ]; then
                continue
            fi

            clear
            tput cnorm
            ensure_sudo

            if [ ${#TARGETS[@]} -eq 1 ]; then
                sel_path="${TARGETS[0]}"
                tgt_name=${sel_path##*/}
                tgt_path="$sel_path"
                sel_idx=$(game_index_by_path "$tgt_path" || true)
                if [ -n "$sel_idx" ] && { [ "${GAMES_STATUS[$sel_idx]}" = "COMPRESSED" ] || { [ "${GAMES_STATUS[$sel_idx]}" = "LOW YIELD" ] && [ "${GAMES_DEDUPE_PENDING[$sel_idx]:-0}" -eq 1 ]; }; }; then
                    hrule
                    echo "  GAME DEDUPLICATION: $tgt_name"
                    hrule
                    echo "  This game is already compressed; only deduplication will run."
                    echo -e "Press [${BOLD}y${RESET}] to deduplicate, or any other key to cancel..."
                    read_input
                    if [[ "$KEY" =~ ^[Yy]$ ]]; then
                        run_dedupe_paths "DEDUPLICATION: $tgt_name" "$tgt_path"
                        case "$?" in 130) exit 130 ;; 143) exit 143 ;; esac
                        if [ -n "$sel_idx" ] && [ "${DEDUPE_COMPLETION_RECORDED:-0}" -eq 1 ]; then
                            GAMES_STATUS[$sel_idx]="COMPACTED"
                            GAMES_DEDUPE_PENDING[$sel_idx]=0
                        fi
                        echo "Press any key to return..."
                        read_input
                    fi
                    NEEDS_FULL_CLEAR=1
                    continue
                fi

                hrule
                echo "  GAME COMPRESSION: $tgt_name"
                hrule
                echo "  Location: $tgt_path"
                echo ""
                echo "Analyzing current disk usage..."
                b_raw=$(run_compsize "$tgt_path" || true)
                b_total=$(echo "$b_raw" | grep "^TOTAL" || true)
                b_disk="N/A"
                b_disk_bytes=""; b_raw_bytes=""
                if [ -n "$b_total" ]; then
                    b_disk=$(echo "$b_total" | awk '{print $3}')
                    u_disk=$(echo "$b_total" | awk '{print $4}')
                    ratio=$(echo "$b_total" | awk '{print $2}')
                    b_disk_bytes=$(echo "$b_total" | awk '{print $6}')
                    b_raw_bytes=$(echo "$b_total" | awk '{print $7}')
                    echo "  Current footprint on disk: $b_disk (Raw: $u_disk, Extent ratio: $ratio)"
                elif [ "$COMPSIZE_OK" -ne 1 ]; then
                    echo -e "  ${YELLOW}Native measurement unavailable - savings cannot be measured.${RESET}"
                fi
                hrule
                echo -e "Press [${BOLD}y${RESET}] to compress with ZSTD, or any other key to cancel..."
                read_input
                if [[ "$KEY" =~ ^[Yy]$ ]]; then
                    discover_running_games
                    if game_is_running "$tgt_path"; then
                        echo -e "${YELLOW}  $tgt_name is running right now - close it and try again.${RESET}"
                        read_input
                        NEEDS_FULL_CLEAR=1
                        continue
                    fi
                    echo ""
                    echo ">>> Compressing game with ZSTD... (please wait)"
                    s_t=$(date +%s)
                    result=$(compress_and_record "$tgt_name" "$tgt_path" "$b_disk_bytes" "$b_raw_bytes" "$(logical_game_bytes "$tgt_path")"); compression_rc=$?
                    case "$compression_rc" in 130|143) exit "$compression_rc" ;; esac
                    if [ "$compression_rc" -ne 0 ]; then
                        echo -e "${RED}  Defragmentation failed for $tgt_name; saved state was not changed.${RESET}"
                        read_input
                        NEEDS_FULL_CLEAR=1
                        continue
                    fi
                    e_t=$(( $(date +%s) - s_t ))
                    print_summary_block "$tgt_name" "$b_disk" "$result" "$tgt_path"
                    echo -e "    ${GREEN}✓ Finished in ${e_t}s${RESET}"
                    run_dedupe_paths "DEDUPLICATION: $tgt_name" "$tgt_path"
                    case "$?" in 130) exit 130 ;; 143) exit 143 ;; esac
                    CHECKED_STATE[$sel_path]=0
                    sel_idx=$(game_index_by_path "$sel_path" || true)
                    if [ -n "$sel_idx" ]; then
                        if [ "${DEDUPE_COMPLETION_RECORDED:-0}" -eq 1 ]; then GAMES_STATUS[$sel_idx]="COMPACTED"; else GAMES_STATUS[$sel_idx]="COMPRESSED"; fi
                    fi
                    echo "Press any key to return..."
                    read_input
                fi
            else
                hrule
                echo "  COMPRESSING ${#TARGETS[@]} SELECTED GAMES"
                hrule
                for t_path in "${TARGETS[@]}"; do
                    echo "  • $(basename "$t_path")"
                done
                hrule
                echo -e "Press [${BOLD}y${RESET}] to proceed with all, or any other key to cancel..."
                read_input
                if [[ "$KEY" =~ ^[Yy]$ ]]; then
                    t_cur=1
                    for t_path in "${TARGETS[@]}"; do
                        tgt_name=$(basename "$t_path")
                        tgt_path="$t_path"
                        t_idx=$(game_index_by_path "$tgt_path" || true)
                        if [ -n "$t_idx" ] && { [ "${GAMES_STATUS[$t_idx]}" = "COMPRESSED" ] || { [ "${GAMES_STATUS[$t_idx]}" = "LOW YIELD" ] && [ "${GAMES_DEDUPE_PENDING[$t_idx]:-0}" -eq 1 ]; }; }; then
                            echo ""
                            echo "Deduplicating only: $tgt_name (already compressed)"
                            run_dedupe_paths "DEDUPLICATION: $tgt_name" "$tgt_path"
                            case "$?" in 130) exit 130 ;; 143) exit 143 ;; esac
                            if [ "${DEDUPE_COMPLETION_RECORDED:-0}" -eq 1 ]; then
                                GAMES_STATUS[$t_idx]="COMPACTED"
                                GAMES_DEDUPE_PENDING[$t_idx]=0
                            fi
                            t_cur=$((t_cur + 1))
                            continue
                        fi
                        # See batch_compress_routine: the guarantee has to hold
                        # at the moment of the write, not when the list was built.
                        discover_running_games
                        if game_is_running "$tgt_path"; then
                            echo ""
                            echo -e "${YELLOW}  Skipping $tgt_name: it is running right now.${RESET}"
                            continue
                        fi
                        echo ""
                        echo -e "${BOLD}[$t_cur/${#TARGETS[@]}] Compressing: ${CYAN}$tgt_name${RESET} ... "
                        s_t=$(date +%s)
                        b_raw=$(run_compsize "$tgt_path" || true)
                        b_disk=$(echo "$b_raw" | awk '/^TOTAL/ {print $3}')
                        [ -n "$b_disk" ] || b_disk="N/A"
                        b_disk_bytes=$(echo "$b_raw" | awk '/^TOTAL/ {print $6}')
                        b_raw_bytes=$(echo "$b_raw" | awk '/^TOTAL/ {print $7}')
                        result=$(compress_and_record "$tgt_name" "$tgt_path" "$b_disk_bytes" "$b_raw_bytes" "$(logical_game_bytes "$tgt_path")"); compression_rc=$?
                        case "$compression_rc" in 130|143) exit "$compression_rc" ;; esac
                        if [ "$compression_rc" -ne 0 ]; then
                            echo -e "${RED}  Defragmentation failed for $tgt_name; saved state was not changed.${RESET}"
                            t_cur=$(( t_cur + 1 ))
                            continue
                        fi
                        e_t=$(( $(date +%s) - s_t ))
                        print_summary_block "$tgt_name" "$b_disk" "$result" "$tgt_path"
                        echo -e "    ${GREEN}✓ Finished in ${e_t}s${RESET}"
                        run_dedupe_paths "DEDUPLICATION: $tgt_name" "$tgt_path"
                        case "$?" in 130) exit 130 ;; 143) exit 143 ;; esac
                        CHECKED_STATE[$t_path]=0
                        t_idx=$(game_index_by_path "$tgt_path" || true)
                        if [ -n "$t_idx" ]; then
                            if [ "${DEDUPE_COMPLETION_RECORDED:-0}" -eq 1 ]; then GAMES_STATUS[$t_idx]="COMPACTED"; else GAMES_STATUS[$t_idx]="COMPRESSED"; fi
                        fi
                        t_cur=$(( t_cur + 1 ))
                    done
                    echo "Press any key to return..."
                    read_input
                fi
            fi
            NEEDS_FULL_CLEAR=1
            discover_data
            ;;
        *)
            drain_pending_input
            continue ;;
    esac
done
